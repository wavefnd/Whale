module {
  format_version 4
  semantics_version 1
  target "x86_64-whale-linux"
  datalayout { ptr=64, endian=little }

  declare @f0 "increment": whale (i32) -> i32, linkage internal
  declare @f1 "write": whale (ptr<u32>) -> ptr<u32>, linkage internal
  declare @f2 "relay": whale (ptr<u32>, bool) -> ptr<u32>, linkage internal
  declare @f3 "answer": whale () -> u32, linkage internal
  declare @f4 "local": whale () -> ptr<u32>, linkage internal
  declare @f5 "countdown": whale (i32) -> i32, linkage internal
  declare @f6 "indirect_countdown": whale (u32) -> u32, linkage internal
  declare @f7 "function_value": whale () -> fnptr<whale (i32) -> i32>, linkage internal

  declare @f100 "set": whale (ptr<u32>) -> void, linkage internal
  declare @f101 "branch_bool": whale (bool) -> bool, linkage internal

  fn @f0 "increment"(%v0 "x": i32) -> i32, entry %b0 {
  %b0 "entry":
    %v1: ptr<i32> = alloca i32, align 4
    store i32 %v0, ptr<i32> %v1, align 4
    %v2: i32 = load i32, ptr<i32> %v1, align 4
    %v3: i32 = const i32 1
    %v4: i32 = add i32 %v2, %v3
    ret i32 %v4
  }

  fn @f1 "write"(%v0 "pointer": ptr<u32>) -> ptr<u32>, entry %b0 {
  %b0 "entry":
    %v1: u32 = const u32 42
    store u32 %v1, ptr<u32> %v0, align 4
    ret ptr<u32> %v0
  }

  fn @f2 "relay"(%v0 "pointer": ptr<u32>, %v1 "condition": bool) -> ptr<u32>, entry %b0 {
  %b0 "entry":
    %v2: ptr<u32> = call whale ptr<u32> @f1(%v0)
    cbr bool %v1, label %b1, label %b2
  %b1 "yes":
    %v3: ptr<u32> = select bool %v1, ptr<u32> %v2, ptr<u32> %v0
    br label %b3
  %b2 "no":
    %v4: ptr<u32> = mov ptr<u32> %v2
    br label %b3
  %b3 "join":
    %v5: ptr<u32> = phi ptr<u32> [ %v3, %b1 ], [ %v4, %b2 ]
    %v6: ptr<ptr<u32>> = alloca ptr<u32>, align 8
    store ptr<u32> %v5, ptr<ptr<u32>> %v6, align 8
    %v7: ptr<u32> = load ptr<u32>, ptr<ptr<u32>> %v6, align 8
    ret ptr<u32> %v7
  }

  fn @f3 "answer"() -> u32, entry %b0 {
  %b0 "entry":
    %v0: ptr<u32> = alloca u32, align 4
    %v1: bool = const bool true
    %v2: ptr<u32> = call whale ptr<u32> @f2(%v0, %v1)
    %v3: u32 = load u32, ptr<u32> %v2, align 4
    ret u32 %v3
  }

  fn @f4 "local"() -> ptr<u32>, entry %b0 {
  %b0 "entry":
    %v0: ptr<u32> = alloca u32, align 4
    %v1: u32 = const u32 42
    store u32 %v1, ptr<u32> %v0, align 4
    ret ptr<u32> %v0
  }

  fn @f5 "countdown"(%v0 "n": i32) -> i32, entry %b0 {
  %b0 "entry":
    %v1: i32 = const i32 0
    %v2: bool = icmp eq i32 %v0, %v1
    cbr bool %v2, label %b1, label %b2
  %b1 "base":
    ret i32 %v1
  %b2 "recursive":
    %v3: i32 = const i32 1
    %v4: i32 = sub i32 %v0, %v3
    %v5: i32 = call whale i32 @f5(%v4)
    %v6: i32 = add i32 %v5, %v3
    ret i32 %v6
  }

  fn @f6 "indirect_countdown"(%v0 "n": u32) -> u32, entry %b0 {
  %b0 "entry":
    %v1: u32 = const u32 0
    %v2: bool = icmp eq u32 %v0, %v1
    cbr bool %v2, label %b1, label %b2
  %b1 "base":
    ret u32 %v1
  %b2 "recursive":
    %v3: u32 = const u32 1
    %v4: u32 = sub u32 %v0, %v3
    %v5: fnptr<whale (u32) -> u32> = function_addr @f6
    %v6: u32 = call whale u32 indirect %v5(%v4)
    %v7: u32 = add u32 %v6, %v3
    ret u32 %v7
  }

  fn @f7 "function_value"() -> fnptr<whale (i32) -> i32>, entry %b0 {
  %b0 "entry":
    %v0: fnptr<whale (i32) -> i32> = function_addr @f0
    ret fnptr<whale (i32) -> i32> %v0
  }
  fn @f100 "set"(%v0 "pointer": ptr<u32>) -> void, entry %b0 {
  %b0 "entry":
    %v1: u32 = const u32 42
    store u32 %v1, ptr<u32> %v0, align 4
    ret void
  }

  fn @f101 "branch_bool"(%v0 "condition": bool) -> bool, entry %b0 {
  %b0 "entry":
    cbr bool %v0, label %b1, label %b2
  %b1 "yes":
    ret bool %v0
  %b2 "no":
    ret bool %v0
  }
}

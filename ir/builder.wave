// Exact typed construction model. Memory is owned by the caller; Wave validates
// a transaction completely before publishing identities, types or block state.
// Type tags match the typed IR inventory, never storage-size equivalence classes.
struct IrBuilderType { kind: u64; depth: u64; children: u64; auxiliary: u64; }

struct IrBuilderValue { id: u64; first_type: u64; type_count: u64; }

struct IrBuilderBlock { id: u64; terminated: u64; non_phi: u64; }

struct IrBuilderState { next_value: u64; next_block: u64; type_count: u64; instruction_count: u64; namespace_nodes: u64; namespace_bytes: u64; next_function: u64; next_global: u64; work: u64; }

struct IrBuilderResult { status: u64; detail: u64; value: u64; work: u64; }

// 1 invalid transport/model; 2 depth; 3 nodes; 4 work; 5 identity overflow;
// 6 unknown block; 7 terminated block; 8 unknown value; 9 phi order.
fun ir_builder_type_check(types: ptr<IrBuilderType>, count: u64, depth_limit: u64,
    node_limit: u64, work_limit: u64, result: ptr<IrBuilderResult>) -> i32 {
    if (!ir_span_valid(types as ptr<u8>, count, 32) || count == 0) { return 1; }
    if (count > node_limit) { return 3; }
    if (count > work_limit) { return 4; }
    var remaining: array<u64, 258>;
    var level: u64 = 0;
    remaining[0] = 1;
    var index: u64 = 0;
    while (index < count) {
        while (remaining[level] == 0 && level > 0) { level -= 1; }
        var node: IrBuilderType = types[index];
        result.detail = index;
        if (remaining[level] == 0 || node.depth != level) { return 1; }
        if (level > depth_limit || level > 257) { return 2; }
        if (node.kind > 21) { return 1; }
        if (node.kind <= 16 && node.children != 0) { return 1; }
        // Pointer/array have one child. Function pointer stores return first,
        // then parameters, and convention/variadic bits in auxiliary.
        if ((node.kind == 17 || node.kind == 19) && node.children != 1) { return 1; }
        if (node.kind == 18 && (node.children == 0 || node.auxiliary > 3)) { return 1; }
        if (node.children > count - index - 1) { return 1; }
        remaining[level] -= 1;
        if (node.children != 0) {
            if (level == depth_limit || level == 257) { return 2; }
            level += 1;
            remaining[level] = node.children;
        }
        index += 1;
    }
    while (level > 0 && remaining[level] == 0) { level -= 1; }
    if (remaining[level] != 0) { return 1; }
    result.work = count;
    return 0;
}

export(c) fun whale_ir_builder_type(types: ptr<IrBuilderType>, count: u64,
    depth_limit: u64, node_limit: u64, work_limit: u64,
    result: ptr<IrBuilderResult>) -> i32 {
    if (result == null) { return 1; }
    result.status = 0; result.detail = 0; result.value = 0; result.work = 0;
    var status: i32 = ir_builder_type_check(types, count, depth_limit, node_limit, work_limit, result);
    result.status = status as u64;
    return status;
}

// mode 0 probes without mutation; mode 1 publishes the complete append.
// kind 0 appends a typed value; kind 1 appends a basic block.
export(c) fun whale_ir_builder_allocate(state: ptr<IrBuilderState>, kind: u64,
    types: ptr<IrBuilderType>, count: u64, depth_limit: u64, node_limit: u64,
    work_limit: u64, mode: u64, output_types: ptr<IrBuilderType>, type_capacity: u64,
    output_values: ptr<IrBuilderValue>, value_capacity: u64,
    output_blocks: ptr<IrBuilderBlock>, block_capacity: u64,
    result: ptr<IrBuilderResult>) -> i32 {
    if (result == null) { return 1; }
    result.status = 0; result.detail = 0; result.value = 0; result.work = 0;
    if (state == null || kind > 1 || mode > 1 || state.type_count > node_limit || state.work > work_limit) {
        result.status = 1; return 1;
    }
    var used_nodes: u64 = state.namespace_nodes;
    if (used_nodes > node_limit || state.type_count > node_limit - used_nodes) { result.status = 3; return 3; }
    used_nodes += state.type_count;
    if (state.next_value > node_limit - used_nodes) { result.status = 3; return 3; }
    used_nodes += state.next_value;
    if (state.next_block > node_limit - used_nodes) { result.status = 3; return 3; }
    used_nodes += state.next_block;
    if (state.instruction_count > node_limit - used_nodes) { result.status = 3; return 3; }
    used_nodes += state.instruction_count;
    if (used_nodes == node_limit) { result.status = 3; return 3; }
    var cost: u64 = 1;
    if (kind == 0) {
        var status: i32 = ir_builder_type_check(types, count, depth_limit,
            node_limit - used_nodes - 1, work_limit - state.work, result);
        if (status != 0) { result.status = status as u64; return status; }
        if (count > (18446744073709551615 - 1) / 2) { result.status = 4; return 4; }
        cost = count * 2 + 1;
        if (state.next_value >= 4294967295) { result.status = 5; return 5; }
        result.value = state.next_value;
    } else {
        if (state.next_block >= 4294967295) { result.status = 5; return 5; }
        result.value = state.next_block;
    }
    if (cost > work_limit - state.work) { result.status = 4; return 4; }
    result.work = cost;
    if (mode == 0) { return 0; }
    if (kind == 0) {
        if (state.type_count > type_capacity || count > type_capacity - state.type_count
            || state.next_value >= value_capacity
            || !ir_span_valid(output_types as ptr<u8>, type_capacity, 32)
            || !ir_span_valid(output_values as ptr<u8>, value_capacity, 24)) {
            result.status = 1; return 1;
        }
        var index: u64 = 0;
        while (index < count) { output_types[state.type_count + index] = types[index]; index += 1; }
        output_values[state.next_value].id = state.next_value;
        output_values[state.next_value].first_type = state.type_count;
        output_values[state.next_value].type_count = count;
        state.type_count += count;
        state.next_value += 1;
    } else {
        if (state.next_block >= block_capacity || !ir_span_valid(output_blocks as ptr<u8>, block_capacity, 24)) {
            result.status = 1; return 1;
        }
        output_blocks[state.next_block].id = state.next_block;
        output_blocks[state.next_block].terminated = 0;
        output_blocks[state.next_block].non_phi = 0;
        state.next_block += 1;
    }
    state.work += cost;
    return 0;
}

// The complete instruction inventory is expressed as operation kind 0..33:
// GlobalAddr, LifetimeEnd, PtrDiff, ConstDecl, Const, Undef, Mov, Bin, Neg,
// Not, Cmp, ICmp, FCmp, Select, Cast, Phi, Extract, Checked, Alloca,
// VolatileLoad, VolatileStore, Load, Uninit, Store, Gep, Memcpy, Memset,
// NullFunction, FunctionAddr, Call, TrapIf; Br, CBr/Switch, Ret/Trap.
// check_only skips publication. Op 34 checks identities, 35 checks insertion;
// op 36 inserts an entry-hoisted alloca before its existing terminator.
export(c) fun whale_ir_builder_order(state: ptr<IrBuilderState>, node_limit: u64, blocks: ptr<IrBuilderBlock>, block_count: u64,
    first_block: u64, first_value: u64, value_end: u64, block: u64,
    op: u64, operands: ptr<u64>, operand_count: u64,
    targets: ptr<u64>, target_count: u64, check_only: u64,
    max_work: u64, result: ptr<IrBuilderResult>) -> i32 {
    if (result == null) { return 1; }
    result.status = 0; result.detail = block; result.value = 0; result.work = 0;
    if (state == null || op > 36 || check_only > 1 || first_block > block_count || first_value > value_end
        || !ir_span_valid(blocks as ptr<u8>, block_count, 24)
        || !ir_span_valid(operands as ptr<u8>, operand_count, 8)
        || !ir_span_valid(targets as ptr<u8>, target_count, 8)) { result.status = 1; return 1; }
    if (state.work > max_work) { result.status = 4; return 4; }
    var available_work: u64 = max_work - state.work;
    if (op >= 34 && op != 36) { available_work = max_work; }
    if (operand_count > available_work || target_count > available_work - operand_count
        || available_work - operand_count - target_count < 1) { result.status = 4; return 4; }
    if (op < 34 || op == 36) {
        var expected: u64 = 0;
        if (op == 1 || op == 6 || op == 8 || op == 9 || op == 14 || op == 16
            || op == 19 || op == 21 || op == 22 || op == 30) { expected = 1; }
        if (op == 2 || op == 7 || op == 10 || op == 11 || op == 12 || op == 17
            || op == 20 || op == 23) { expected = 2; }
        if (op == 13 || op == 25 || op == 26) { expected = 3; }
        if (op != 15 && op != 24 && op != 29 && op != 32 && op != 33 && operand_count != expected) {
            result.status = 1; return 1;
        }
        if ((op == 15 && operand_count != target_count) || (op == 24 && operand_count == 0)
            || (op == 31 && target_count != 1) || (op == 32 && (operand_count != 1 || target_count == 0))
            || (op == 33 && (operand_count > 1 || target_count != 0))) { result.status = 1; return 1; }
        if (op != 15 && op != 31 && op != 32 && target_count != 0) { result.status = 1; return 1; }
        var nodes: u64 = state.namespace_nodes;
        if (nodes > node_limit || state.type_count > node_limit - nodes) { result.status = 3; return 3; }
        nodes += state.type_count;
        if (nodes > node_limit || state.next_value > node_limit - nodes) { result.status = 3; return 3; }
        nodes += state.next_value;
        if (state.next_block > node_limit - nodes) { result.status = 3; return 3; }
        nodes += state.next_block;
        if (state.instruction_count >= node_limit - nodes) { result.status = 3; return 3; }
        nodes += state.instruction_count + 1;
        if (operand_count > node_limit - nodes || target_count > node_limit - nodes - operand_count) {
            result.status = 3; return 3;
        }
    }
    if (block < first_block || block >= block_count || blocks[block].id != block) { result.status = 6; return 6; }
    if (op != 34 && op != 36 && blocks[block].terminated != 0) { result.status = 7; return 7; }
    var index: u64 = 0;
    while (index < operand_count) {
        if (operands[index] < first_value || operands[index] >= value_end) {
            result.detail = operands[index]; result.status = 8; return 8;
        }
        index += 1;
    }
    index = 0;
    while (index < target_count) {
        if (targets[index] < first_block || targets[index] >= block_count
            || blocks[targets[index]].id != targets[index]) {
            result.detail = targets[index]; result.status = 6; return 6;
        }
        index += 1;
    }
    if (op == 15 && blocks[block].non_phi != 0) { result.status = 9; return 9; }
    result.work = operand_count + target_count + 1;
    if (check_only == 0 && (op < 34 || op == 36)) {
        state.instruction_count += operand_count + target_count + 1;
        state.work += result.work;
        if (op >= 31 && op <= 33) { blocks[block].terminated = 1; }
        else { if (op != 15) { blocks[block].non_phi = 1; } }
    }
    return 0;
}

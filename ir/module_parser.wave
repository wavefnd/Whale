// SPDX-License-Identifier: MPL-2.0
// Incremental versioned module grammar. Wave owns production selection and
// loop/ordering/version rules; callers construct values from typed events.
struct IrModuleState {
    phase: u64; at: u64; format: u64; nodes: u64; work: u64;
    a: u64; b: u64; c: u64; d: u64; e: u64; f: u64; g: u64;
    name: u64; link: u64; terminated: u64;
}

struct IrModuleEvent {
    status: u64; reason: u64; at: u64; expected: u64; event: u64; role: u64;
    a: u64; b: u64; c: u64; d: u64; e: u64; f: u64; g: u64;
    name: u64; link: u64; next: u64; nodes: u64; work: u64;
}

struct IrModuleParser {
    tokens: ptr<IrTextToken>; count: u64; state: ptr<IrModuleState>;
    max_nodes: u64; max_work: u64; result: ptr<IrModuleEvent>;
}

fun ir_module_word(token: ptr<IrTextToken>, code: u64) -> bool {
    var first: u64 = 0; var second: u64 = 0; var length: u64 = 0;
    if (code == 0) { first = 125; second = 0; length = 1; } // }
    else if (code == 1) { first = 58; second = 0; length = 1; } // :
    else if (code == 2) { first = 61; second = 0; length = 1; } // =
    else if (code == 3) { first = 500152823651; second = 0; length = 5; } // const
    else if (code == 4) { first = 44; second = 0; length = 1; } // ,
    else if (code == 5) { first = 474181364833; second = 0; length = 5; } // align
    else if (code == 6) { first = 8104338990102572649; second = 114; length = 9; } // init_expr
    else if (code == 7) { first = 435761734006; second = 0; length = 5; } // value
    else if (code == 8) { first = 7019269490406420085; second = 431199250796; length = 13; } // uninitialized
    else if (code == 9) { first = 126939459445601; second = 0; length = 6; } // access
    else if (code == 10) { first = 8749489600778560882; second = 0; length = 8; } // readonly
    else if (code == 11) { first = 8388361638065038706; second = 101; length = 9; } // readwrite
    else if (code == 12) { first = 28542640759662956; second = 0; length = 7; } // linkage
    else if (code == 13) { first = 7809644666444607081; second = 0; length = 8; } // internal
    else if (code == 14) { first = 7809644666444609637; second = 0; length = 8; } // external
    else if (code == 15) { first = 7881702178978425196; second = 101; length = 9; } // link_name
    else if (code == 16) { first = 435610019959; second = 0; length = 5; } // whale
    else if (code == 17) { first = 57408520157555; second = 0; length = 6; } // sysv64
    else if (code == 18) { first = 40; second = 0; length = 1; } // (
    else if (code == 19) { first = 41; second = 0; length = 1; } // )
    else if (code == 20) { first = 15917; second = 0; length = 2; } // ->
    else if (code == 21) { first = 521611275877; second = 0; length = 5; } // entry
    else if (code == 22) { first = 123; second = 0; length = 1; } // {
    else if (code == 23) { first = 7376726192452628339; second = 6646889; length = 11; } // source_file
    else if (code == 24) { first = 7809644627822735983; second = 0; length = 8; } // original
    else if (code == 25) { first = 1701736302; second = 0; length = 4; } // none
    else if (code == 26) { first = 7881129350718123891; second = 28769; length = 10; } // source_map
    else if (code == 27) { first = 8386676065534439017; second = 7237481; length = 11; } // instruction
    else if (code == 28) { first = 8386105380227409268; second = 29295; length = 10; } // terminator
    else if (code == 29) { first = 119165519096935; second = 0; length = 6; } // global
    else if (code == 30) { first = 28542640877171827; second = 0; length = 7; } // storage
    else if (code == 31) { first = 28554735403623780; second = 0; length = 7; } // declare
    else if (code == 32) { first = 28262; second = 0; length = 2; } // fn
    else if (code == 33) { first = 29282; second = 0; length = 2; } // br
    else if (code == 34) { first = 7496291; second = 0; length = 3; } // cbr
    else if (code == 35) { first = 114776364119923; second = 0; length = 6; } // switch
    else if (code == 36) { first = 7628146; second = 0; length = 3; } // ret
    else if (code == 37) { first = 1885434484; second = 0; length = 4; } // trap
    else { return false; }
    if (token.kind == 1 || token.kind == 3 || token.length != length) { return false; }
    var i: u64 = 0;
    while (i < length) {
        var packed: u64 = first; if (i >= 8) { packed = second; }
        if (token.data[i] as u64 != ((packed >> ((i & 7) * 8)) & 255)) { return false; }
        i += 1;
    }
    return true;
}

fun ir_module_fail(p: ptr<IrModuleParser>, status: u64, reason: u64, at: u64, expected: u64) -> bool {
    p.result.status = status; p.result.reason = reason; p.result.at = at;
    p.result.expected = expected; return false;
}

fun ir_module_charge(p: ptr<IrModuleParser>, amount: u64) -> bool {
    if (amount > p.max_work - p.state.work) { return ir_module_fail(p, 4, 0, p.state.at, 0); }
    p.state.work += amount; return true;
}

fun ir_module_read(p: ptr<IrModuleParser>) -> bool {
    if (p.state.at >= p.count) { return ir_module_fail(p, 6, 0, p.state.at, 0); }
    var token: ptr<IrTextToken> = &p.tokens[p.state.at];
    if (token.kind > 3 || !ir_span_valid(token.data, token.length, 1)) { return ir_module_fail(p, 6, 0, p.state.at, 0); }
    return ir_module_charge(p, 1 + token.length);
}

fun ir_module_eat(p: ptr<IrModuleParser>, code: u64) -> bool {
    if (!ir_module_read(p)) { return false; }
    if (!ir_module_word(&p.tokens[p.state.at], code)) { return false; }
    p.state.at += 1; return true;
}

fun ir_module_expect(p: ptr<IrModuleParser>, code: u64) -> bool {
    if (ir_module_eat(p, code)) { return true; }
    if (p.result.status != 0) { return false; }
    return ir_module_fail(p, 1, 1, p.state.at, code);
}

fun ir_module_node(p: ptr<IrModuleParser>) -> bool {
    if (p.state.nodes >= p.max_nodes) { return ir_module_fail(p, 3, 0, p.state.at, 0); }
    p.state.nodes += 1; return true;
}

fun ir_module_number(p: ptr<IrModuleParser>, maximum: u64, output: ptr<u64>) -> bool {
    if (!ir_module_read(p)) { return false; }
    var token: ptr<IrTextToken> = &p.tokens[p.state.at];
    if (token.kind != 0 || token.length == 0) { return ir_module_fail(p, 1, 2, p.state.at, 0); }
    var value: u64 = 0; var i: u64 = 0; var overflow: bool = false;
    while (i < token.length) {
        var octet: u64 = token.data[i] as u64;
        if (octet < 48 || octet > 57) { return ir_module_fail(p, 1, 2, p.state.at, 0); }
        var digit: u64 = octet - 48;
        if (value > (maximum - digit) / 10) { overflow = true; }
        if (!overflow) { value = value * 10 + digit; }
        i += 1;
    }
    if (overflow) { return ir_module_fail(p, 1, 3, p.state.at, 0); }
    output[0] = value; p.state.at += 1; return true;
}

fun ir_module_id(p: ptr<IrModuleParser>, prefix: u64, output: ptr<u64>) -> bool {
    if (!ir_module_read(p)) { return false; }
    var token: ptr<IrTextToken> = &p.tokens[p.state.at];
    var first: u64 = 64; var second: u64 = 0;
    if (prefix == 0) { first = 37; second = 118; }
    else if (prefix == 1) { first = 37; second = 98; }
    else if (prefix == 2) { second = 103; }
    else if (prefix == 3) { second = 102; }
    else if (prefix == 4) { second = 115; }
    else { return ir_module_fail(p, 6, 0, p.state.at, 0); }
    if (token.kind == 1 || token.kind == 3 || token.length < 2
        || token.data[0] as u64 != first || token.data[1] as u64 != second) {
        return ir_module_fail(p, 1, 4, p.state.at, prefix);
    }
    if (token.length == 2) { return ir_module_fail(p, 1, 5, p.state.at, 0); }
    var value: u64 = 0; var i: u64 = 2; var overflow: bool = false;
    while (i < token.length) {
        var octet: u64 = token.data[i] as u64;
        if (octet < 48 || octet > 57) { return ir_module_fail(p, 1, 5, p.state.at, 0); }
        var digit: u64 = octet - 48;
        if (value > (4294967295 - digit) / 10) { overflow = true; }
        if (!overflow) { value = value * 10 + digit; }
        i += 1;
    }
    if (overflow) { return ir_module_fail(p, 1, 6, p.state.at, 0); }
    output[0] = value; p.state.at += 1; return true;
}

fun ir_module_string(p: ptr<IrModuleParser>, output: ptr<u64>) -> bool {
    if (!ir_module_read(p)) { return false; }
    if (p.tokens[p.state.at].kind != 1) { return ir_module_fail(p, 1, 7, p.state.at, 0); }
    output[0] = p.state.at; p.state.at += 1; return true;
}

fun ir_module_choose(p: ptr<IrModuleParser>, first: u64, second: u64, reason: u64, output: ptr<u64>) -> bool {
    if (!ir_module_read(p)) { return false; }
    var token: ptr<IrTextToken> = &p.tokens[p.state.at];
    if (token.kind != 0) { return ir_module_fail(p, 1, 8, p.state.at, 0); }
    var choice: u64 = 0;
    if (ir_module_word(token, first)) { choice = 0; }
    else if (ir_module_word(token, second)) { choice = 1; }
    else { return ir_module_fail(p, 1, reason, p.state.at, 0); }
    output[0] = choice; p.state.at += 1; return true;
}

fun ir_module_align(p: ptr<IrModuleParser>) -> bool {
    return ir_module_expect(p, 4) && ir_module_expect(p, 5)
        && ir_module_number(p, 4294967295, &p.state.b);
}

fun ir_module_link(p: ptr<IrModuleParser>) -> bool {
    if (!ir_module_expect(p, 4) || !ir_module_expect(p, 12)
        || !ir_module_choose(p, 13, 14, 14, &p.state.d)) { return false; }
    p.state.link = 18446744073709551615;
    if (ir_module_eat(p, 4)) {
        return ir_module_expect(p, 15) && ir_module_string(p, &p.state.link);
    }
    return p.result.status == 0;
}

fun ir_module_event(p: ptr<IrModuleParser>, event: u64, role: u64) -> bool {
    p.result.event = event; p.result.role = role;
    p.result.a = p.state.a; p.result.b = p.state.b; p.result.c = p.state.c;
    p.result.d = p.state.d; p.result.e = p.state.e; p.result.f = p.state.f; p.result.g = p.state.g;
    p.result.name = p.state.name; p.result.link = p.state.link;
    return true;
}

fun ir_module_request(p: ptr<IrModuleParser>, event: u64, role: u64, phase: u64) -> bool {
    p.state.phase = phase; return ir_module_event(p, event, role);
}

fun ir_module_parameter(p: ptr<IrModuleParser>) -> bool {
    return ir_module_node(p) && ir_module_id(p, 0, &p.state.a)
        && ir_module_string(p, &p.state.name) && ir_module_expect(p, 1)
        && ir_module_request(p, 100, 7, 41);
}

fun ir_module_function_return(p: ptr<IrModuleParser>) -> bool {
    return ir_module_expect(p, 20) && ir_module_request(p, 100, 8, 42);
}

fun ir_module_step(p: ptr<IrModuleParser>) -> bool {
    var phase: u64 = p.state.phase;
    if (phase == 0) {
        if (ir_module_eat(p, 0)) { p.state.phase = 99; return ir_module_event(p, 14, 0); }
        if (p.result.status != 0 || !ir_module_node(p) || !ir_module_read(p)) { return false; }
        var token: ptr<IrTextToken> = &p.tokens[p.state.at];
        if (token.kind != 0) { return ir_module_fail(p, 1, 8, p.state.at, 0); }
        var field: u64 = 23;
        while (field <= 32 && !ir_module_word(token, field)) { field += 1; }
        p.state.at += 1;
        if (field == 23 || field == 24 || field == 26) {
            if (p.state.format < 7) { return ir_module_fail(p, 1, 9, p.state.at, 0); }
        }
        if (field == 23) {
            return ir_module_id(p, 4, &p.state.a) && ir_module_string(p, &p.state.name)
                && ir_module_event(p, 1, 0);
        }
        if (field == 24) {
            if (!ir_module_number(p, 18446744073709551615, &p.state.a)) { return false; }
            if (ir_module_eat(p, 25)) { p.state.g = 0; return ir_module_event(p, 2, 0); }
            p.state.g = 1;
            return p.result.status == 0 && ir_module_id(p, 4, &p.state.b)
                && ir_module_number(p, 4294967295, &p.state.c)
                && ir_module_number(p, 4294967295, &p.state.d)
                && ir_module_number(p, 4294967295, &p.state.e)
                && ir_module_number(p, 4294967295, &p.state.f)
                && ir_module_event(p, 2, 0);
        }
        if (field == 26) {
            if (!ir_module_read(p)) { return false; }
            token = &p.tokens[p.state.at];
            if (token.kind != 0) { return ir_module_fail(p, 1, 8, p.state.at, 0); }
            if (ir_module_word(token, 27)) { p.state.a = 0; }
            else if (ir_module_word(token, 28)) { p.state.a = 1; }
            else if (ir_module_word(token, 29)) { p.state.a = 2; }
            else { return ir_module_fail(p, 1, 11, p.state.at, 0); }
            p.state.at += 1;
            if (p.state.a == 2) {
                if (!ir_module_id(p, 2, &p.state.b)) { return false; }
            } else {
                if (!ir_module_id(p, 3, &p.state.b) || !ir_module_id(p, 1, &p.state.c)) { return false; }
                if (p.state.a == 0 && !ir_module_number(p, 18446744073709551615, &p.state.d)) { return false; }
            }
            return ir_module_number(p, 18446744073709551615, &p.state.e) && ir_module_event(p, 3, 0);
        }
        if (field == 29 || field == 30) {
            if (field == 30 && p.state.format < 6) { return ir_module_fail(p, 1, 10, p.state.at - 1, 0); }
            if (!ir_module_id(p, 2, &p.state.a) || !ir_module_string(p, &p.state.name)
                || !ir_module_expect(p, 1)) { return false; }
            if (field == 29) { return ir_module_request(p, 100, 1, 10); }
            return ir_module_request(p, 100, 3, 20);
        }
        if (field == 31) {
            if (!ir_module_id(p, 3, &p.state.a) || !ir_module_string(p, &p.state.name)
                || !ir_module_expect(p, 1) || !ir_module_choose(p, 16, 17, 15, &p.state.c)
                || !ir_module_expect(p, 18)) { return false; }
            if (ir_module_eat(p, 19)) {
                return ir_module_expect(p, 20) && ir_module_request(p, 100, 6, 32);
            }
            return p.result.status == 0 && ir_module_request(p, 100, 5, 31);
        }
        if (field == 32) {
            if (!ir_module_id(p, 3, &p.state.a) || !ir_module_string(p, &p.state.name)
                || !ir_module_expect(p, 18)) { return false; }
            p.state.phase = 40; return ir_module_event(p, 7, 0);
        }
        return ir_module_fail(p, 1, 16, p.state.at - 1, 0);
    }
    if (phase == 10) {
        return ir_module_expect(p, 2) && ir_module_expect(p, 3) && ir_module_request(p, 100, 2, 11);
    }
    if (phase == 11) { return ir_module_request(p, 101, 1, 12); }
    if (phase == 12) {
        return ir_module_align(p) && ir_module_expect(p, 4) && ir_module_expect(p, 6)
            && ir_module_request(p, 102, 1, 13);
    }
    if (phase == 13) { p.state.phase = 0; return ir_module_event(p, 4, 0); }
    if (phase == 20) {
        if (!ir_module_expect(p, 2) || !ir_module_choose(p, 8, 7, 12, &p.state.e)) { return false; }
        if (p.state.e != 0) { return ir_module_request(p, 100, 4, 21); }
        p.state.phase = 22; return ir_module_step(p);
    }
    if (phase == 21) { return ir_module_request(p, 101, 2, 22); }
    if (phase == 22) {
        if (!ir_module_align(p) || !ir_module_expect(p, 4) || !ir_module_expect(p, 9)
            || !ir_module_choose(p, 11, 10, 13, &p.state.c) || !ir_module_link(p)) { return false; }
        p.state.phase = 0; return ir_module_event(p, 5, 0);
    }
    if (phase == 31) {
        if (ir_module_eat(p, 19)) { return ir_module_expect(p, 20) && ir_module_request(p, 100, 6, 32); }
        return p.result.status == 0 && ir_module_expect(p, 4) && ir_module_request(p, 100, 5, 31);
    }
    if (phase == 32) {
        if (!ir_module_link(p)) { return false; }
        p.state.phase = 0; return ir_module_event(p, 6, 0);
    }
    if (phase == 40) {
        if (ir_module_eat(p, 19)) { return ir_module_function_return(p); }
        return p.result.status == 0 && ir_module_parameter(p);
    }
    if (phase == 41) { p.state.phase = 46; return ir_module_event(p, 8, 0); }
    if (phase == 46) {
        if (ir_module_eat(p, 19)) { return ir_module_function_return(p); }
        return p.result.status == 0 && ir_module_expect(p, 4) && ir_module_parameter(p);
    }
    if (phase == 42) {
        if (!ir_module_expect(p, 4) || !ir_module_expect(p, 21)
            || !ir_module_id(p, 1, &p.state.a) || !ir_module_expect(p, 22)) { return false; }
        p.state.phase = 44; return ir_module_event(p, 9, 0);
    }
    if (phase == 44) {
        if (ir_module_eat(p, 0)) { p.state.phase = 0; return ir_module_event(p, 13, 0); }
        if (p.result.status != 0 || !ir_module_node(p) || !ir_module_id(p, 1, &p.state.a)
            || !ir_module_string(p, &p.state.name) || !ir_module_expect(p, 1)) { return false; }
        p.state.phase = 45; p.state.terminated = 0; return ir_module_event(p, 10, 0);
    }
    if (phase == 45) {
        if (!ir_module_read(p)) { return false; }
        var token: ptr<IrTextToken> = &p.tokens[p.state.at];
        var block_prefix: bool = token.kind != 1 && token.kind != 3 && token.length >= 2
            && token.data[0] == 37 && token.data[1] == 98;
        if (block_prefix || ir_module_word(token, 0)) { p.state.phase = 44; return ir_module_event(p, 12, 0); }
        if (p.state.terminated != 0) { return ir_module_fail(p, 1, 17, p.state.at, 0); }
        if (!ir_module_node(p)) { return false; }
        var word: u64 = 33;
        while (word <= 37 && !ir_module_word(token, word)) { word += 1; }
        if (word <= 37) { p.state.terminated = 1; return ir_module_event(p, 104, 0); }
        return ir_module_event(p, 103, 0);
    }
    return ir_module_fail(p, 6, 0, p.state.at, 0);
}

export(c) fun whale_ir_module_step(tokens: ptr<IrTextToken>, token_count: u64,
    state: ptr<IrModuleState>, max_nodes: u64, max_work: u64,
    result: ptr<IrModuleEvent>) -> i32 {
    if (result == null) { return 6; }
    result.status = 0; result.reason = 0; result.at = 0; result.expected = 0;
    result.event = 0; result.role = 0; result.nodes = 0; result.work = 0;
    if (state == null || !ir_span_valid(tokens as ptr<u8>, token_count, 24)
        || state.at >= token_count || state.format < 3 || state.format > 8) {
        result.status = 6; return 6;
    }
    state.nodes = 0; state.work = 0;
    var parser: IrModuleParser;
    parser.tokens = tokens; parser.count = token_count; parser.state = state;
    parser.max_nodes = max_nodes; parser.max_work = max_work; parser.result = result;
    if (!ir_module_step(&parser) && result.status == 0) { result.status = 6; }
    result.next = state.at; result.nodes = state.nodes; result.work = state.work;
    return result.status as i32;
}

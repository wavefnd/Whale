// Canonical little-endian decoding. Lengths are checked before allocation or reads.
fun ir_bytecode_read(data: ptr<u8>, at: u64) -> u64 {
    var value: u64 = 0;
    var i: u64 = 0;
    while (i < 8) {
        value = value | ((data[at + i] as u64) << (i * 8));
        i += 1;
    }
    return value;
}

fun ir_bytecode_sizes(counts: ptr<IrBytecodeCounts>, limits: ptr<IrBytecodeLimits>,
    result: ptr<IrBytecodeResult>) -> bool {
    var values: ptr<u64> = counts as ptr<u64>;
    var total: u64 = 0;
    var records: u64 = 0;
    var table: u64 = 1;
    while (table <= 16) {
        var count: u64 = values[table - 1];
        var stride: u64 = ir_bytecode_native_stride(table);
        if (count > limits.max_decoded_bytes / stride
            || count * stride > limits.max_decoded_bytes - total) {
            return ir_bytecode_fail(result, 2, 2, table, count);
        }
        total += count * stride;
        if (table != 11) {
            if (records > limits.max_records || count > limits.max_records - records) {
                return ir_bytecode_fail(result, 2, 3, table, count);
            }
            records += count;
        }
        table += 1;
    }
    // A linear bound for CFG, SSA, source indexes and initialized type scratch.
    var words: u64 = 256;
    table = 1;
    while (table <= 16) {
        var factor: u64 = 32;
        if (table == 4) { factor = 96; }
        if (table == 6) { factor = 48; }
        if (table == 7) { factor = 32; }
        if (table == 15) { factor = 0; }
        if (table == 11) { factor = 0; }
        var count: u64 = values[table - 1];
        if (factor != 0 && count > (18446744073709551615 - words) / factor) {
            return ir_bytecode_fail(result, 2, 4, table, count);
        }
        words += count * factor;
        table += 1;
    }
    if (words > limits.max_workspace_bytes / 8
        || total > limits.max_workspace_bytes - words * 8) {
        return ir_bytecode_fail(result, 2, 4, 0, words);
    }
    result.decoded_bytes = total;
    result.scratch_words = words;
    return true;
}

export(c) fun whale_ir_bytecode_probe(data: ptr<u8>, count: u64,
    limits: ptr<IrBytecodeLimits>, result: ptr<IrBytecodeResult>) -> i32 {
    if (result == null) { return 4; }
    ir_bytecode_result_init(result);
    if (limits == null || !ir_span_valid(data, count, 1)) {
        ir_bytecode_fail(result, 4, 1, 0, 0);
        return result.status as i32;
    }
    if (count > limits.max_input_bytes) {
        ir_bytecode_fail(result, 2, 1, 0, count);
        return result.status as i32;
    }
    if (count < 576) {
        ir_bytecode_fail(result, 1, 1, 0, count);
        return result.status as i32;
    }
    if (!ir_bytecode_charge(result, limits, 576)) { return result.status as i32; }
    if (ir_bytecode_read(data, 0) != 18931688839137367 || ir_bytecode_read(data, 8) != 1
        || ir_bytecode_read(data, 16) != 1 || ir_bytecode_read(data, 24) != 1
        || ir_bytecode_read(data, 32) != count || ir_bytecode_read(data, 40) != 16
        || ir_bytecode_read(data, 48) != 0 || ir_bytecode_read(data, 56) != 576) {
        ir_bytecode_fail(result, 1, 2, 0, 0);
        return result.status as i32;
    }
    var counts: ptr<u64> = &result.counts as ptr<u64>;
    var end: u64 = 576;
    var table: u64 = 1;
    while (table <= 16) {
        var at: u64 = 64 + (table - 1) * 32;
        var offset: u64 = ir_bytecode_read(data, at + 8);
        var amount: u64 = ir_bytecode_read(data, at + 16);
        var stride: u64 = ir_bytecode_stride(table);
        if (ir_bytecode_read(data, at) != table || offset != end
            || ir_bytecode_read(data, at + 24) != stride
            || amount > (count - end) / stride) {
            ir_bytecode_fail(result, 1, 3, table, 0);
            return result.status as i32;
        }
        counts[table - 1] = amount;
        end += amount * stride;
        table += 1;
    }
    if (end != count) {
        ir_bytecode_fail(result, 1, 4, 0, end);
        return result.status as i32;
    }
    if (!ir_bytecode_sizes(&result.counts, limits, result)) { return result.status as i32; }
    return 0;
}

export(c) fun whale_ir_bytecode_load(data: ptr<u8>, count: u64,
    program: ptr<IrBytecodeProgram>, scratch: ptr<u64>, capacity: u64,
    limits: ptr<IrBytecodeLimits>, result: ptr<IrBytecodeResult>) -> i32 {
    var status: i32 = whale_ir_bytecode_probe(data, count, limits, result);
    if (status != 0) { return status; }
    if (program == null || !ir_span_valid(scratch as ptr<u8>, capacity, 8)) {
        ir_bytecode_fail(result, 4, 1, 0, 0);
        return result.status as i32;
    }
    if (capacity < result.scratch_words) {
        ir_bytecode_fail(result, 2, 4, 0, capacity);
        return result.status as i32;
    }
    var counts: ptr<u64> = &result.counts as ptr<u64>;
    var table: u64 = 1;
    while (table <= 16) {
        if (ir_bytecode_count(program, table) != counts[table - 1]
            || !ir_span_valid(ir_bytecode_data(program, table), counts[table - 1],
                ir_bytecode_native_stride(table))) {
            ir_bytecode_fail(result, 4, 2, table, 0);
            return result.status as i32;
        }
        table += 1;
    }
    table = 1;
    while (table <= 16) {
        var offset: u64 = ir_bytecode_read(data, 64 + (table - 1) * 32 + 8);
        var records: u64 = counts[table - 1];
        var i: u64 = 0;
        if (table == 11) {
            if (!ir_bytecode_charge(result, limits, records)) { return result.status as i32; }
            while (i < records) {
                program.text_bytes[i] = data[offset + i];
                i += 1;
            }
        } else {
            while (i < records) {
                result.table = table;
                result.index = i;
                var stride: u64 = ir_bytecode_stride(table);
                if (!ir_bytecode_charge(result, limits, stride)) { return result.status as i32; }
                var destination: ptr<u64> = ir_bytecode_data(program, table) as ptr<u64>;
                var native_words: u64 = ir_bytecode_native_stride(table) / 8;
                var word: u64 = 0;
                while (word < native_words) {
                    destination[i * native_words + word] = 0;
                    word += 1;
                }
                if (table == 5) {
                    var inst: ptr<IrRuntimeInstruction> = &program.instructions[i];
                    var fields: ptr<u64> = inst as ptr<u64>;
                    word = 0;
                    var file_word: u64 = 0;
                    while (word < 21) {
                        if (word != 9 && word != 10 && word != 19 && word != 20) {
                            fields[word] = ir_bytecode_read(data, offset + i * stride + file_word * 8);
                            file_word += 1;
                        }
                        word += 1;
                    }
                } else if (table == 8) {
                    var global: ptr<IrRuntimeGlobal> = &program.globals[i];
                    global.id = ir_bytecode_read(data, offset + i * stride);
                    global.ty = ir_bytecode_read(data, offset + i * stride + 8);
                    global.align = ir_bytecode_read(data, offset + i * stride + 16);
                    global.readonly = ir_bytecode_read(data, offset + i * stride + 24);
                    global.initialized = ir_bytecode_read(data, offset + i * stride + 32);
                    global.value.literal = ir_bytecode_read(data, offset + i * stride + 40);
                    global.value.low = ir_bytecode_read(data, offset + i * stride + 48);
                    global.value.high = ir_bytecode_read(data, offset + i * stride + 56);
                    if (global.initialized == 1) {
                        global.value.kind = 1;
                        global.value.ty = global.ty;
                        global.value.origin = 1;
                    }
                } else {
                    word = 0;
                    while (word < native_words) {
                        destination[i * native_words + word] =
                            ir_bytecode_read(data, offset + i * stride + word * 8);
                        word += 1;
                    }
                }
                i += 1;
            }
        }
        table += 1;
    }
    return ir_bytecode_verify_impl(program, scratch, capacity, limits, result);
}

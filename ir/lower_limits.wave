// SPDX-License-Identifier: MPL-2.0
// Streaming AST admission, feature gates, numeric syntax and source identities.
struct IrAstInspectState { nodes: u64; strings: u64; features: u64; numbers: u64; sources: u64; work: u64; }

struct IrAstInspectEvent { tag: u64; a: u64; b: u64; c: u64; d: u64; e: u64; f: u64; bytes: ptr<u8>; length: u64; }

struct IrAstInspectSlot { id: u64; occupied: u64; }

struct IrAstInspectResult { status: u64; }

fun ir_ast_inspect_width(bits: u64) -> bool {
    return bits == 1 || bits == 8 || bits == 16 || bits == 32 || bits == 64 || bits == 128;
}

fun ir_ast_inspect_strings(state: ptr<IrAstInspectState>, length: u64, limit: u64) -> i32 {
    if (state.strings > limit || length > limit - state.strings) { return 4; }
    state.strings += length; return 0;
}

fun ir_ast_inspect_probe(slots: ptr<IrAstInspectSlot>, capacity: u64, id: u64,
    state: ptr<IrAstInspectState>, max_work: u64) -> u64 {
    var at: u64 = ir_source_mix(id) & (capacity - 1);
    while (true) {
        if (!ir_cfg_charge(&state.work, max_work)) { return capacity; }
        if (slots[at].occupied == 0 || slots[at].id == id) { return at; }
        at = (at + 1) & (capacity - 1);
    }
    return capacity;
}

export(c) fun whale_ir_ast_inspect_rehash(state: ptr<IrAstInspectState>,
    old: ptr<IrAstInspectSlot>, old_capacity: u64,
    slots: ptr<IrAstInspectSlot>, capacity: u64, max_work: u64,
    result: ptr<IrAstInspectResult>) -> i32 {
    if (result == null) { return 8; }
    result.status = 8;
    if (state == null || state.work > max_work || capacity < 2 || !ir_power_two(capacity)
        || old_capacity > capacity || state.sources > capacity / 2
        || !ir_span_valid(old as ptr<u8>, old_capacity, 16)
        || !ir_span_valid(slots as ptr<u8>, capacity, 16)) { return 8; }
    var i: u64 = 0;
    while (i < capacity) {
        if (!ir_cfg_charge(&state.work, max_work)) { result.status = 7; return 7; }
        slots[i].occupied = 0; i += 1;
    }
    i = 0; var copied: u64 = 0;
    while (i < old_capacity) {
        if (old[i].occupied > 1) { return 8; }
        if (old[i].occupied == 1) {
            var at: u64 = ir_ast_inspect_probe(slots, capacity, old[i].id, state, max_work);
            if (at == capacity) { result.status = 7; return 7; }
            if (slots[at].occupied != 0) { return 8; }
            slots[at].id = old[i].id; slots[at].occupied = 1; copied += 1;
        }
        i += 1;
    }
    if (copied != state.sources) { return 8; }
    result.status = 0; return 0;
}

export(c) fun whale_ir_ast_inspect_step(state: ptr<IrAstInspectState>,
    event: ptr<IrAstInspectEvent>, max_depth: u64, max_nodes: u64, max_strings: u64,
    max_source_work: u64, slots: ptr<IrAstInspectSlot>, capacity: u64,
    result: ptr<IrAstInspectResult>) -> i32 {
    if (result == null) { return 8; }
    result.status = 8;
    if (state == null || event == null || state.features > 7 || state.numbers > 1
        || state.nodes > max_nodes || state.strings > max_strings
        || state.work > max_source_work) { return 8; }
    var status: i32 = 0;
    if (event.tag <= 1) {
        var depth: u64 = max_depth; if (depth > 32) { depth = 32; }
        if (event.tag == 1 && event.a > depth) { status = 2; }
        else if (state.nodes >= max_nodes) { status = 3; }
        else { state.nodes += 1; }
    } else if (event.tag == 2) { status = ir_ast_inspect_strings(state, event.length, max_strings); }
    else if (event.tag == 3) {
        // Source form: 1 struct type, 2 storage/expression, 3 store, 4 bit_not, 5 binary.
        if (event.a >= 1 && event.a <= 3) { state.features = state.features | 4; }
        else if (event.a == 4 || (event.a == 5 && event.b > 2 && event.b <= 11)) { state.features = state.features | 1; }
        else if (event.a != 5 || event.b > 11) { status = 8; }
    } else if (event.tag >= 4 && event.tag <= 7) {
        var valid: bool = ir_ast_inspect_width(event.a);
        if (event.tag == 5 || event.tag == 7) { valid = event.a == 16 || event.a == 32 || event.a == 64; }
        if (event.tag >= 6) {
            status = ir_ast_inspect_strings(state, event.length, max_strings);
            if (status == 0) {
                if (!ir_span_valid(event.bytes, event.length, 1)) { status = 8; }
                else if (event.tag == 6) {
                    var at: u64 = 0;
                    if (event.length > 0 && event.bytes[0] == 45) { at = 1; }
                    if (at == event.length) { valid = false; }
                    while (at < event.length) {
                        if (event.bytes[at] < 48 || event.bytes[at] > 57) { valid = false; }
                        at += 1;
                    }
                } else if (event.length != 2 + event.a / 4 || event.length < 2) { valid = false; }
                else if (event.bytes[0] != 48 || event.bytes[1] != 120) { valid = false; }
                else {
                    var at: u64 = 2;
                    while (at < event.length) {
                        var b: u8 = event.bytes[at];
                        if (!((b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102))) { valid = false; }
                        at += 1;
                    }
                }
            }
        }
        if (!valid) { state.numbers = 0; }
    } else if (event.tag == 8) {
        if (event.b > 1 || capacity < 2 || !ir_power_two(capacity)
            || state.sources >= capacity / 2
            || !ir_span_valid(slots as ptr<u8>, capacity, 16)) { status = 8; }
        else {
            var at: u64 = ir_ast_inspect_probe(slots, capacity, event.a, state, max_source_work);
            if (at == capacity) { status = 7; }
            else if (slots[at].occupied != 0) { status = 1; }
            else {
                slots[at].id = event.a; slots[at].occupied = 1; state.sources += 1; state.features = state.features | 2;
                if (event.b == 1) {
                    status = ir_ast_inspect_strings(state, event.length, max_strings);
                    if (status == 0) {
                        if (!ir_span_valid(event.bytes, event.length, 1)) { status = 8; }
                        else if (event.length == 0 || event.c == 0 || event.d == 0 || event.e == 0 || event.f == 0
                            || event.c > event.e || (event.c == event.e && event.d > event.f)) { status = 1; }
                        else if (event.length > max_source_work - state.work) { status = 7; }
                        else {
                            state.work += event.length;
                            var i: u64 = 0;
                            while (i < event.length) { if (event.bytes[i] == 0) { status = 1; } i += 1; }
                        }
                    }
                }
            }
        }
    } else { status = 8; }
    result.status = status as u64; return status;
}

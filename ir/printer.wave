// Expand a mathematical 128-bit magnitude with portable limb division.
// Avoiding native u128 division keeps cross objects independent of libgcc.
fun irp_integer(s: ptr<IrPrintState>, low: u64, high: u64, signed_value: bool,
    depth: u64) -> bool {
    var negative: bool = signed_value && (high >> 63) != 0;
    if (negative) {
        high = ~high;
        if (low == 0) { high += 1; }
        else { low = ~low + 1; }
    }
    var remaining: bool = true;
    while (remaining) {
        var q_high: u64 = high / 10;
        var rem: u64 = high % 10;
        var q_low: u64 = 0;
        var bit: u64 = 64;
        while (bit != 0) {
            bit -= 1;
            rem = rem * 2 + ((low >> bit) & 1);
            if (rem >= 10) { rem -= 10; q_low = q_low | ((1 as u64) << bit); }
        }
        if (!irp_push(s, 1, rem + 48, 1, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        low = q_low; high = q_high;
        remaining = low != 0 || high != 0;
    }
    if (negative) { return irp_push(s, 1, 45, 1, 0, 0, 0, 0, 0, 0, depth); }
    return true;
}

fun irp_hex(s: ptr<IrPrintState>, value: u64, digits: u64, depth: u64) -> bool {
    if (digits > 16) { s.status = 1; return false; }
    while (digits != 0) {
        var digit: u64 = value & 15;
        var octet: u64 = digit + 48;
        if (digit >= 10) { octet = digit + 87; }
        if (!irp_push(s, 1, octet, 1, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        value = value >> 4;
        digits -= 1;
    }
    return true;
}

fun irp_string(s: ptr<IrPrintState>, data: ptr<u8>, length: u64,
    at: u64, depth: u64) -> bool {
    if (at == length) { return irp_push(s, 1, 34, 1, 0, 0, 0, 0, 0, 0, depth); }
    var width: u64 = 0;
    var cp: u64 = 0;
    if (!ir_lex_utf8(data, length, at, &width, &cp)) { s.status = 1; return false; }
    if (!irp_push(s, 9, data as u64, length, at + width, 0, 0, 0, 0, 0, depth)) { return false; }
    if (cp == 92 || cp == 34) {
        return irp_push(s, 1, 92 | (cp << 8), 2, 0, 0, 0, 0, 0, 0, depth);
    }
    if (cp == 10 || cp == 13 || cp == 9 || cp == 0) {
        var code: u64 = 48;
        if (cp == 10) { code = 110; }
        else if (cp == 13) { code = 114; }
        else if (cp == 9) { code = 116; }
        return irp_push(s, 1, 92 | (code << 8), 2, 0, 0, 0, 0, 0, 0, depth);
    }
    if (cp < 32 || (cp >= 127 && cp <= 159) || cp == 8232 || cp == 8233) {
        if (!irp_push(s, 1, 125, 1, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        var digits: u64 = 1;
        var remaining: u64 = cp >> 4;
        while (remaining != 0) { digits += 1; remaining = remaining >> 4; }
        if (!irp_hex(s, cp, digits, depth)) { return false; }
        return irp_push(s, 1, 8090972, 3, 0, 0, 0, 0, 0, 0, depth);
    }
    var packed: u64 = 0;
    var i: u64 = 0;
    while (i < width) { packed = packed | ((data[at + i] as u64) << (8 * i)); i += 1; }
    return irp_push(s, 1, packed, width, 0, 0, 0, 0, 0, 0, depth);
}

// Status: 0 complete, 1 malformed transport, 2 output limit, 3 stack,
// 4 work, 5 depth, 6 chunk ready. Each call advances the same state and
// publishes at most capacity bytes; all status/error paths respect the ceiling.
export(c) fun whale_ir_print_step(s: ptr<IrPrintState>, root: u64,
    output: ptr<u8>, capacity: u64, written: ptr<u64>) -> i32 {
    if (s == null || written == null) { return 1; }
    written[0] = 0;
    if (!ir_span_valid(output, capacity, 1)
        || !ir_span_valid(s.nodes as ptr<u8>, s.node_count, 96)
        || !ir_span_valid(s.edges as ptr<u8>, s.edge_count, 8)
        || !ir_span_valid(s.stack as ptr<u8>, s.stack_capacity, 80)
        || s.stack_len > s.stack_capacity || s.total > s.output_limit
        || s.initialized > 1 || s.depth_limit > 1024) { s.status = 1; return 1; }
    if (s.status != 0) { return s.status as i32; }
    if (s.initialized == 0) {
        if (s.stack_len != 0) { s.status = 1; return 1; }
        s.initialized = 1;
        if (!irp_push(s, 2, root, 0, 0, 0, 0, 0, 0, 0, 0)) { return s.status as i32; }
    }
    // Locals are scalar fields, never a loop-local aggregate alloca.
    while (s.stack_len != 0 && s.status == 0) {
        if (s.work == 0) { s.status = 4; break; }
        s.work -= 1;
        var p: ptr<u64> = &s.stack[(s.stack_len - 1) * 10];
        var kind: u64 = p[0];
        var a: u64 = p[1]; var b: u64 = p[2]; var c: u64 = p[3]; var d: u64 = p[4];
        var e: u64 = p[5]; var f: u64 = p[6]; var g: u64 = p[7]; var h: u64 = p[8];
        var depth: u64 = p[9];
        if (kind == 1) {
            if (b > 8) { s.status = 1; break; }
            if (b == 0) { s.stack_len -= 1; }
            else {
                if (s.total == s.output_limit) { s.status = 2; break; }
                if (written[0] == capacity) { return 6; }
                output[written[0]] = (a & 255) as u8;
                written[0] += 1; s.total += 1;
                p[1] = a >> 8; p[2] = b - 1;
            }
        } else {
            s.stack_len -= 1;
            if (kind == 2) { irp_expand(s, a, depth); }
            else if (kind == 3) { irp_integer(s, a, 0, false, depth); }
            else if (kind == 4) { irp_integer(s, a, b, false, depth); }
            else if (kind == 5) { irp_integer(s, a, b, true, depth); }
            else if (kind == 6) { irp_hex(s, a, b, depth); }
            else if (kind == 7) {
                if (!ir_span_valid(a as ptr<u8>, b, 1)) { s.status = 1; }
                else if (irp_push(s, 9, a, b, 0, 0, 0, 0, 0, 0, depth)) {
                    irp_push(s, 1, 34, 1, 0, 0, 0, 0, 0, 0, depth);
                }
            } else if (kind == 8) {
                if (a > s.edge_count || b > s.edge_count - a || d > 8 || f > 8 || h > 8) { s.status = 1; }
                else if (b != 0) {
                    var child: u64 = s.edges[a];
                    if (irp_push(s, 8, a + 1, b - 1, c, d, e, f, g, h, depth)
                        && irp_push(s, 1, c, 0, 0, 0, 0, 0, 0, 0, depth)) {
                        // The separator belongs before subsequent items, not after the last.
                        // Encode the continuation's prefix in its first-item flag below.
                        if (b > 1) { s.stack[(s.stack_len - 1) * 10 + 2] = d; }
                        // Move separator beneath the child and its suffix.
                        irp_push(s, 1, g, h, 0, 0, 0, 0, 0, 0, depth);
                        irp_push(s, 2, child, 0, 0, 0, 0, 0, 0, 0, depth + 1);
                        irp_push(s, 1, e, f, 0, 0, 0, 0, 0, 0, depth);
                    }
                }
            } else if (kind == 9) { irp_string(s, a as ptr<u8>, b, c, depth); }
            else { s.status = 1; }
        }
    }
    return s.status as i32;
}

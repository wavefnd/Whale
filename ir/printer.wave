fun irp_expand(s: ptr<IrPrintState>, index: u64, depth: u64) -> bool {
    if (index >= s.node_count) { s.status = 1; return false; }
    if (depth > s.depth_limit) { s.status = 5; return false; }
    var n: ptr<u64> = &s.nodes[index * 12];
    var tag: u64 = n[0];
    if (tag == 1) {
        // "void"
        if (!irp_push(s, 1, 1684631414, 4, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        return true;
    }
    if (tag == 2) {
        // "bool"
        if (!irp_push(s, 1, 1819242338, 4, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        return true;
    }
    if (tag == 3) {
        // "i1"
        if (!irp_push(s, 1, 12649, 2, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        return true;
    }
    if (tag == 4) {
        // "u1"
        if (!irp_push(s, 1, 12661, 2, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        return true;
    }
    if (tag == 5) {
        // "i8"
        if (!irp_push(s, 1, 14441, 2, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        return true;
    }
    if (tag == 6) {
        // "i16"
        if (!irp_push(s, 1, 3551593, 3, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        return true;
    }
    if (tag == 7) {
        // "i32"
        if (!irp_push(s, 1, 3289961, 3, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        return true;
    }
    if (tag == 8) {
        // "i64"
        if (!irp_push(s, 1, 3421801, 3, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        return true;
    }
    if (tag == 9) {
        // "i128"
        if (!irp_push(s, 1, 942813545, 4, 0, 0, 0, 0, 0, 0, depth)) { return false; }
        return true;
    }

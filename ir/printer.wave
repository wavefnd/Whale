        }
        if (value == 8) {
            // "ft"
            if (!irp_push(s, 1, 29798, 2, 0, 0, 0, 0, 0, 0, depth)) { return false; }
            // "shift_le"
            if (!irp_push(s, 1, 7308321248854501491, 8, 0, 0, 0, 0, 0, 0, depth)) { return false; }
            return true;
        }
        if (value == 9) {
            // "ght"
            if (!irp_push(s, 1, 7628903, 3, 0, 0, 0, 0, 0, 0, depth)) { return false; }
            // "shift_ri"
            if (!irp_push(s, 1, 7598240474866477171, 8, 0, 0, 0, 0, 0, 0, depth)) { return false; }

// Canonical IR grammar and byte escaping live here. Rust supplies a flat,
// borrowed model and drains bounded chunks; it does not choose print syntax.
// The caller owns the resumable task stack. No global strings or allocation.
struct IrPrintState {
    nodes: ptr<u64>; node_count: u64;
    edges: ptr<u64>; edge_count: u64;
    stack: ptr<u64>; stack_capacity: u64; stack_len: u64;
    output_limit: u64; total: u64; work: u64; depth_limit: u64;
    status: u64; initialized: u64;
}

fun irp_push(s: ptr<IrPrintState>, kind: u64, a: u64, b: u64, c: u64,
    d: u64, e: u64, f: u64, g: u64, h: u64, depth: u64) -> bool {
    if (s.status != 0) { return false; }
    if (s.work == 0) { s.status = 4; return false; }
    s.work -= 1;
    if (s.stack_len >= s.stack_capacity) { s.status = 3; return false; }
    var p: ptr<u64> = &s.stack[s.stack_len * 10];
    p[0] = kind; p[1] = a; p[2] = b; p[3] = c; p[4] = d;
    p[5] = e; p[6] = f; p[7] = g; p[8] = h; p[9] = depth;
    s.stack_len += 1;
    return true;
}

fun irp_list(s: ptr<IrPrintState>, first: u64, count: u64, separator: u64,
    separator_len: u64, before: u64, before_len: u64,
    after: u64, after_len: u64, depth: u64) -> bool {
    if (first > s.edge_count || count > s.edge_count - first) {
        s.status = 1; return false;
    }
    return irp_push(s, 8, first, count, separator, separator_len,
        before, before_len, after, after_len, depth);
}

fun irp_operator(s: ptr<IrPrintState>, family: u64, value: u64, depth: u64) -> bool {
    if (family == 1) {
        if (value == 0) {
            // "add"
            if (!irp_push(s, 1, 6579297, 3, 0, 0, 0, 0, 0, 0, depth)) { return false; }
            return true;
        }
        if (value == 1) {
            // "sub"
            if (!irp_push(s, 1, 6452595, 3, 0, 0, 0, 0, 0, 0, depth)) { return false; }
            return true;
        }
        if (value == 2) {
            // "mul"
            if (!irp_push(s, 1, 7107949, 3, 0, 0, 0, 0, 0, 0, depth)) { return false; }
            return true;

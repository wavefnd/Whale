        if (value == 10) {
            // "and"
            if (!irp_push(s, 1, 6581857, 3, 0, 0, 0, 0, 0, 0, depth)) { return false; }
            // "logical_"
            if (!irp_push(s, 1, 6875977810685947756, 8, 0, 0, 0, 0, 0, 0, depth)) { return false; }
            return true;
        }
        if (value == 11) {
            // "or"
            if (!irp_push(s, 1, 29295, 2, 0, 0, 0, 0, 0, 0, depth)) { return false; }
            // "logical_"
            if (!irp_push(s, 1, 6875977810685947756, 8, 0, 0, 0, 0, 0, 0, depth)) { return false; }
            return true;

// SPDX-License-Identifier: MPL-2.0
// Sparse, function-scoped constant propagation. Each value becomes known once;
// only its indexed users are revisited. No memory, call or trapping fold exists.
struct IrFoldNode {
    op: u64;
    sub: u64;
    scope: u64;
    id: u64;
    kind: u64;
    literal: u64;
    low: u64;
    high: u64;
    first: u64;
    count: u64;
}

struct IrFoldValue {
    known: u64;
    kind: u64;
    low: u64;
    high: u64;
    replace: u64;
}

struct IrFoldSlot {
    key: u64;
    index: u64;
    present: u64;
}

struct IrFoldUser {
    index: u64;
    next: u64;
}

struct IrFoldPending {
    head: u64;
    queued: u64;
}

struct IrFoldInput {
    nodes: ptr<IrFoldNode>;
    count: u64;
    references: ptr<u64>;
    reference_count: u64;
    values: ptr<IrFoldValue>;
    slots: ptr<IrFoldSlot>;
    capacity: u64;
    users: ptr<IrFoldUser>;
    pending: ptr<IrFoldPending>;
    queue: ptr<u64>;
    max_work: u64;
}

struct IrFoldResult {
    status: u64;
    changed: u64;
    folded: u64;
    work: u64;
}

fun ir_fold_charge(p: ptr<IrFoldInput>, result: ptr<IrFoldResult>) -> bool {
    if (result.work >= p.max_work) {
        result.status = 1;
        return false;
    }
    result.work += 1;
    return true;
}

fun ir_fold_error(result: ptr<IrFoldResult>, status: u64) -> i32 {
    result.status = status;
    result.changed = 0;
    result.folded = 0;
    return status as i32;
}

fun ir_fold_mix(value: u64) -> u64 {
    var mixed: u64 = value;
    mixed = (mixed ^ (mixed >> 30)) * 13787848793156543929;
    mixed = (mixed ^ (mixed >> 27)) * 10723151780598845931;
    return mixed ^ (mixed >> 31);
}

fun ir_fold_slot(p: ptr<IrFoldInput>, key: u64, result: ptr<IrFoldResult>) -> u64 {
    var at: u64 = ir_fold_mix(key) & (p.capacity - 1);
    while (true) {
        if (!ir_fold_charge(p, result)) {
            return p.capacity;
        }
        if (p.slots[at].present == 0 || p.slots[at].key == key) {
            return at;
        }
        at = (at + 1) & (p.capacity - 1);
    }
    return p.capacity;
}

fun ir_fold_reference(p: ptr<IrFoldInput>, node: ptr<IrFoldNode>, offset: u64,
    result: ptr<IrFoldResult>) -> u64 {
    var id: u64 = p.references[node.first + offset];
    if (id > 4294967295) {
        result.status = 2;
        return p.count;
    }
    var slot: u64 = ir_fold_slot(p, (node.scope << 32) | id, result);
    if (slot >= p.capacity || p.slots[slot].present == 0) {
        if (result.status == 0) {
            result.status = 2;
        }
        return p.count;
    }
    return p.slots[slot].index;
}

fun ir_fold_literal(node: ptr<IrFoldNode>, value: ptr<IrFoldValue>) -> bool {
    if (ir_integer_width(node.kind) == 0) {
        return node.literal == 0;
    }
    var expected: u64 = 2;
    if (node.kind == 1) {
        expected = 3;
    } else if (ir_integer_signed(node.kind)) {
        expected = 1;
    }
    if (node.literal != expected) {
        return false;
    }
    var number: IrIntegerResult;
    if (whale_ir_integer(5, 0, node.kind, node.kind, node.low, node.high, 0, 0, &number) != 0
        || number.low != node.low || number.high != node.high) {
        return false;
    }
    value.known = 1;
    value.kind = node.kind;
    value.low = node.low;
    value.high = node.high;
    return true;
}

fun ir_fold_compute(p: ptr<IrFoldInput>, index: u64, result: ptr<IrFoldResult>) -> bool {
    var node: IrFoldNode = p.nodes[index];
    if (node.op == 31 || node.op == 63 || node.op == 3 || node.op == 4
        || ir_integer_width(node.kind) == 0) {
        return true;
    }
    var a: IrFoldValue;
    var b: IrFoldValue;
    a.known = 0;
    b.known = 0;
    var position: u64 = ir_fold_reference(p, &node, 0, result);
    if (position >= p.count) {
        return false;
    }
    a = p.values[position];
    if (node.op == 13) {
        if (a.known == 0) {
            return true;
        }
        if (a.kind != 1 || a.high != 0 || a.low > 1) {
            result.status = 2;
            return false;
        }
        var selected: u64 = 2;
        if (a.low == 1) {
            selected = 1;
        }
        position = ir_fold_reference(p, &node, selected, result);
        if (position >= p.count) {
            return false;
        }
        a = p.values[position];
    }
    if (a.known == 0) {
        return true;
    }
    if (a.kind != node.kind) {
        result.status = 2;
        return false;
    }
    if (node.op == 15) {
        var incoming: u64 = 1;
        while (incoming < node.count) {
            position = ir_fold_reference(p, &node, incoming, result);
            if (position >= p.count) {
                return false;
            }
            b = p.values[position];
            if (b.known == 0) {
                return true;
            }
            if (b.kind != node.kind) {
                result.status = 2;
                return false;
            }
            if (a.low != b.low || a.high != b.high) {
                return true;
            }
            incoming += 1;
        }
    }
    var number: IrIntegerResult;
    var status: i32 = 0;
    number.low = a.low;
    number.high = a.high;
    var output_kind: u64 = node.kind;
    if (node.op == 7 || node.op == 10 || node.op == 11) {
        position = ir_fold_reference(p, &node, 1, result);
        if (position >= p.count) {
            return false;
        }
        b = p.values[position];
        if (b.known == 0) {
            return true;
        }
        if (b.kind != node.kind) {
            result.status = 2;
            return false;
        }
        if (node.op == 7) {
            status = whale_ir_integer(0, node.sub, node.kind, node.kind,
                a.low, a.high, b.low, b.high, &number);
        } else {
            output_kind = 1;
            status = whale_ir_integer(3, node.sub, node.kind, 1,
                a.low, a.high, b.low, b.high, &number);
        }
    } else if (node.op == 8 || node.op == 9) {
        status = whale_ir_integer(6, node.op - 8, node.kind, node.kind,
            a.low, a.high, 0, 0, &number);
    }
    if (status == 1 || status == 2) {
        // Preserve dynamic division/remainder traps at their original ordinal.
        return true;
    }
    if (status != 0) {
        result.status = 2;
        return false;
    }
    p.values[index].known = 1;
    p.values[index].kind = output_kind;
    p.values[index].low = number.low;
    p.values[index].high = number.high;
    p.values[index].replace = 1;
    result.changed = 1;
    result.folded += 1;
    return true;
}

export(c) fun whale_ir_fold_integer(p: ptr<IrFoldInput>, result: ptr<IrFoldResult>) -> i32 {
    if (result == null) {
        return 2;
    }
    result.status = 0;
    result.changed = 0;
    result.folded = 0;
    result.work = 0;
    if (p == null || p.capacity < 2 || (p.capacity & (p.capacity - 1)) != 0
        || p.count > p.capacity / 2
        || !ir_span_valid(p.nodes as ptr<u8>, p.count, 80)
        || !ir_span_valid(p.references as ptr<u8>, p.reference_count, 8)
        || !ir_span_valid(p.values as ptr<u8>, p.count, 40)
        || !ir_span_valid(p.slots as ptr<u8>, p.capacity, 24)
        || !ir_span_valid(p.users as ptr<u8>, p.reference_count, 16)
        || !ir_span_valid(p.pending as ptr<u8>, p.count, 16)
        || !ir_span_valid(p.queue as ptr<u8>, p.count, 8)) {
        return ir_fold_error(result, 2);
    }
    var at: u64 = 0;
    while (at < p.capacity) {
        if (!ir_fold_charge(p, result)) {
            return ir_fold_error(result, result.status);
        }
        p.slots[at].present = 0;
        at += 1;
    }
    at = 0;
    var expected_first: u64 = 0;
    while (at < p.count) {
        if (!ir_fold_charge(p, result)) {
            return ir_fold_error(result, result.status);
        }
        var node: IrFoldNode = p.nodes[at];
        if (node.scope > 4294967295 || node.id > 4294967295 || node.kind > 13
            || node.first != expected_first || node.first > p.reference_count
            || node.count > p.reference_count - node.first) {
            return ir_fold_error(result, 2);
        }
        expected_first += node.count;
        var count: u64 = 0;
        if (node.op == 6 || node.op == 8 || node.op == 9) {
            count = 1;
        } else if (node.op == 7 || node.op == 10 || node.op == 11) {
            count = 2;
        } else if (node.op == 13) {
            count = 3;
        } else if (node.op == 15) {
            count = node.count;
            if (count == 0) {
                return ir_fold_error(result, 2);
            }
        } else if (node.op != 3 && node.op != 4 && node.op != 31 && node.op != 63) {
            return ir_fold_error(result, 2);
        }
        if (node.count != count || (node.op == 7 && (node.sub > 17
            || (node.sub >= 7 && node.sub <= 11)))
            || ((node.op == 10 || node.op == 11) && node.sub > 9)) {
            return ir_fold_error(result, 2);
        }
        var slot: u64 = ir_fold_slot(p, (node.scope << 32) | node.id, result);
        if (slot >= p.capacity) {
            return ir_fold_error(result, result.status);
        }
        if (p.slots[slot].present != 0) {
            return ir_fold_error(result, 2);
        }
        p.slots[slot].present = 1;
        p.slots[slot].key = (node.scope << 32) | node.id;
        p.slots[slot].index = at;
        p.values[at].known = 0;
        p.values[at].replace = 0;
        p.values[at].kind = 0;
        p.values[at].low = 0;
        p.values[at].high = 0;
        p.pending[at].head = p.reference_count;
        p.pending[at].queued = 1;
        p.queue[at] = at;
        if ((node.op == 3 || node.op == 4) && !ir_fold_literal(&node, &p.values[at])) {
            return ir_fold_error(result, 2);
        }
        at += 1;
    }
    if (expected_first != p.reference_count) {
        return ir_fold_error(result, 2);
    }
    at = 0;
    while (at < p.count) {
        var node: IrFoldNode = p.nodes[at];
        var offset: u64 = 0;
        while (offset < node.count) {
            var definition: u64 = ir_fold_reference(p, &node, offset, result);
            if (definition >= p.count) {
                return ir_fold_error(result, result.status);
            }
            var edge: u64 = node.first + offset;
            p.users[edge].index = at;
            p.users[edge].next = p.pending[definition].head;
            p.pending[definition].head = edge;
            offset += 1;
        }
        at += 1;
    }
    var head: u64 = 0;
    var tail: u64 = 0;
    var queued: u64 = p.count;
    while (queued > 0) {
        if (!ir_fold_charge(p, result)) {
            return ir_fold_error(result, result.status);
        }
        var index: u64 = p.queue[head];
        head = (head + 1) % p.count;
        queued -= 1;
        p.pending[index].queued = 0;
        if (p.values[index].known == 0) {
            if (!ir_fold_compute(p, index, result)) {
                return ir_fold_error(result, result.status);
            }
            if (p.values[index].known != 0) {
                var edge: u64 = p.pending[index].head;
                while (edge < p.reference_count) {
                    if (!ir_fold_charge(p, result)) {
                        return ir_fold_error(result, result.status);
                    }
                    var user: u64 = p.users[edge].index;
                    if (p.pending[user].queued == 0) {
                        p.pending[user].queued = 1;
                        p.queue[tail] = user;
                        tail = (tail + 1) % p.count;
                        queued += 1;
                    }
                    edge = p.users[edge].next;
                }
            }
        }
    }
    return 0;
}

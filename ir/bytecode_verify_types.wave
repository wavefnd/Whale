// Type and text validation is shared by emission and hostile-file admission.
struct IrBytecodeScratch {
    words: ptr<u64>;
    capacity: u64;
    used: u64;
}

fun ir_bytecode_take(scratch: ptr<IrBytecodeScratch>, count: u64,
    result: ptr<IrBytecodeResult>) -> ptr<u64> {
    if (scratch.used > scratch.capacity || count > scratch.capacity - scratch.used) {
        ir_bytecode_fail(result, 4, 3, 0, count);
        return null;
    }
    var data: ptr<u64> = &scratch.words[scratch.used];
    scratch.used += count;
    return data;
}

fun ir_bytecode_semantic(result: ptr<IrBytecodeResult>, limits: ptr<IrBytecodeLimits>,
    semantic: ptr<IrVerifyResult>, valid: bool) -> bool {
    if (!ir_bytecode_charge(result, limits, semantic.work)) { return false; }
    if (semantic.status == 8) {
        return ir_bytecode_fail(result, 3, 1, result.table, result.index);
    }
    if (!valid || semantic.status != 0) {
        return ir_bytecode_fail(result, 1, 10 + semantic.status, result.table, result.index);
    }
    return true;
}

fun ir_bytecode_semantic_init(semantic: ptr<IrVerifyResult>) {
    semantic.status = 0;
    semantic.index = 0;
    semantic.expected = 0;
    semantic.actual = 0;
    semantic.detail = 0;
    semantic.work = 0;
}

fun ir_bytecode_same(program: ptr<IrBytecodeProgram>, a: u64, b: u64,
    limits: ptr<IrBytecodeLimits>, result: ptr<IrBytecodeResult>) -> bool {
    if (a >= program.type_count || b >= program.type_count) {
        return ir_bytecode_fail(result, 1, 10, result.table, result.index);
    }
    var semantic: IrVerifyResult;
    ir_bytecode_semantic_init(&semantic);
    var valid: bool = ir_verify_equal(a, b, program.types, program.edges,
        limits.max_type_depth, &semantic, limits.max_work - result.work);
    return ir_bytecode_semantic(result, limits, &semantic, valid);
}

fun ir_bytecode_storable(program: ptr<IrBytecodeProgram>, ty: u64,
    limits: ptr<IrBytecodeLimits>, result: ptr<IrBytecodeResult>) -> bool {
    var semantic: IrVerifyResult;
    ir_bytecode_semantic_init(&semantic);
    var valid: bool = ir_verify_storable(ty, program.types, program.edges,
        limits.max_type_depth, &semantic, limits.max_work - result.work);
    return ir_bytecode_semantic(result, limits, &semantic, valid);
}

fun ir_bytecode_value_type(program: ptr<IrBytecodeProgram>, ty: u64) -> bool {
    var node: ptr<IrVerifyType> = &program.types[ty];
    if (node.kind >= 1 && node.kind <= 18) { return true; }
    return node.kind == 21 && node.count == 2
        && ir_verify_integer(program.types[program.edges[node.first]].kind)
        && program.types[program.edges[node.first + 1]].kind == 1;
}

fun ir_bytecode_utf8(data: ptr<u8>, count: u64,
    limits: ptr<IrBytecodeLimits>, result: ptr<IrBytecodeResult>) -> bool {
    // Reuse loop storage at O0; file-controlled iterations must not grow the stack.
    var i: u64;
    var first: u64;
    var width: u64;
    var j: u64;
    var octet: u64;
    var second: u64;

    if (!ir_bytecode_charge(result, limits, count)) { return false; }
    i = 0;
    while (i < count) {
        first = data[i] as u64;
        width = 1;
        if (first >= 194 && first <= 223) { width = 2; }
        else if (first >= 224 && first <= 239) { width = 3; }
        else if (first >= 240 && first <= 244) { width = 4; }
        else if (first >= 128) {
            return ir_bytecode_fail(result, 1, 31, 11, i);
        }
        if (width > count - i) { return ir_bytecode_fail(result, 1, 31, 11, i); }
        j = 1;
        while (j < width) {
            octet = data[i + j] as u64;
            if (octet < 128 || octet > 191) { return ir_bytecode_fail(result, 1, 31, 11, i); }
            j += 1;
        }
        if (width >= 3) {
            second = data[i + 1] as u64;
            if ((first == 224 && second < 160) || (first == 237 && second >= 160)
                || (first == 240 && second < 144) || (first == 244 && second >= 144)) {
                return ir_bytecode_fail(result, 1, 31, 11, i);
            }
        }
        i += width;
    }
    return true;
}

fun ir_bytecode_verify_types(program: ptr<IrBytecodeProgram>, scratch: ptr<IrBytecodeScratch>,
    limits: ptr<IrBytecodeLimits>, result: ptr<IrBytecodeResult>) -> bool {
    // Reuse loop storage at O0; file-controlled iterations must not grow the stack.
    var semantic: IrVerifyResult;
    var valid: bool;
    var depths: ptr<u64>;
    var i: u64;
    var node: ptr<IrVerifyType>;
    var depth: u64;
    var child: u64;
    var next: u64;
    var text_cursor: u64;
    var text: ptr<IrBytecodeText>;

    result.table = 1;
    if (limits.max_type_depth == 0 || limits.max_type_depth > 1024) {
        return ir_bytecode_fail(result, 1, 10, 1, 0);
    }

    ir_bytecode_semantic_init(&semantic);
    valid = ir_verify_graph_valid(program.types, program.type_count, program.edges,
        program.edge_count, limits.max_work - result.work, &semantic);
    if (!ir_bytecode_semantic(result, limits, &semantic, valid)) { return false; }
    depths = ir_bytecode_take(scratch, program.type_count, result);
    if (result.status != 0) { return false; }
    i = 0;
    while (i < program.type_count) {
        result.index = i;
        if (!ir_bytecode_charge(result, limits, 1)) { return false; }
        node = &program.types[i];
        depth = 1;
        if (node.kind <= 16) {
            if (node.child != 0 || node.first != 0 || node.count != 0 || node.extra != 0) {
                return ir_bytecode_fail(result, 1, 11, 1, i);
            }
        } else if (node.kind == 17 || node.kind == 19) {
            if (node.first != 0 || node.extra != 0 || (node.kind == 17 && node.count != 0)) {
                return ir_bytecode_fail(result, 1, 11, 1, i);
            }
            depth = depths[node.child] + 1;
        } else {
            if (node.child != 0 || (node.kind != 18 && node.extra != 0)
                || (node.kind == 18 && (node.count == 0 || node.extra > 3))) {
                return ir_bytecode_fail(result, 1, 11, 1, i);
            }
            child = 0;
            while (child < node.count) {
                if (!ir_bytecode_charge(result, limits, 1)) { return false; }
                next = depths[program.edges[node.first + child]] + 1;
                if (next > depth) { depth = next; }
                child += 1;
            }
        }
        if (depth > limits.max_type_depth) { return ir_bytecode_fail(result, 2, 5, 1, i); }
        depths[i] = depth;
        if (node.kind == 18) {
            ir_bytecode_semantic_init(&semantic);
            valid = ir_verify_signature(i, program.types, program.edges, limits.max_type_depth,
                &semantic, limits.max_work - result.work);
            if (!ir_bytecode_semantic(result, limits, &semantic, valid)) { return false; }
        }
        i += 1;
    }
    i = 0;
    while (i < program.value_type_count) {
        if (!ir_bytecode_charge(result, limits, 1)) { return false; }
        if (program.value_types[i] >= program.type_count || program.value_ids[i] > 4294967295) {
            return ir_bytecode_fail(result, 1, 10, 7, i);
        }
        i += 1;
    }
    if (!ir_bytecode_utf8(program.text_bytes, program.text_byte_count, limits, result)) { return false; }
    text_cursor = 0;
    i = 0;
    while (i < program.text_count) {
        text = &program.texts[i];
        if (text.first != text_cursor || text.first > program.text_byte_count || text.count > program.text_byte_count - text.first) {
            return ir_bytecode_fail(result, 1, 30, 10, i);
        }
        if (!ir_bytecode_utf8(&program.text_bytes[text.first], text.count, limits, result)) { return false; }
        text_cursor += text.count;
        i += 1;
    }
    if (text_cursor != program.text_byte_count) { return ir_bytecode_fail(result, 1, 30, 10, i); }
    return true;
}

struct IrBytecodeType {
    size: u64;
    align: u64;
    depth: u64;
    expanded: u64;
    storable: u64;
}

struct IrBytecodeDefinition {
    block: u64;
    position: u64;
    defined: u64;
    literal: u64;
    low: u64;
    high: u64;
}

struct IrBytecodeVerifier {
    program: ptr<IrBytecodeProgram>;
    limits: ptr<IrBytecodeLimits>;
    result: ptr<IrBytecodeResult>;
    scratch: ptr<IrBytecodeScratch>;
    types: ptr<IrBytecodeType>;
    definitions: ptr<IrBytecodeDefinition>;
    operands: ptr<IrVerifyOperand>;
    operand_capacity: u64;
    owned_bytes: u64;
}

fun ir_bytecode_owned(context: ptr<IrBytecodeVerifier>, amount: u64) -> bool {
    var available: u64 = context.limits.max_workspace_bytes
        - context.result.decoded_bytes - context.result.scratch_words * 8;
    if (context.owned_bytes > available || amount > available - context.owned_bytes) {
        return ir_bytecode_fail(context.result, 2, 6, context.result.table, context.result.index);
    }
    context.owned_bytes += amount;
    return true;
}

fun ir_bytecode_metadata(context: ptr<IrBytecodeVerifier>) -> bool {
    if (!ir_bytecode_owned(context, context.program.text_byte_count)) { return false; }
    var table: u64 = 9;
    while (table <= 16) {
        var allowance: u64 = 0;
        if (table == 9) { allowance = 64; }
        if (table == 10) { allowance = 32; }
        if (table == 12 || table == 13 || table == 14) { allowance = 96; }
        if (table == 16) { allowance = 16; }
        var count: u64 = ir_bytecode_count(context.program, table);
        if (allowance != 0) {
            if (count > context.limits.max_workspace_bytes / allowance) {
                return ir_bytecode_fail(context.result, 2, 6, table, count);
            }
            if (!ir_bytecode_owned(context, count * allowance)) { return false; }
        }
        table += 1;
    }
    return true;
}

fun ir_bytecode_layouts(context: ptr<IrBytecodeVerifier>) -> bool {
    // Reuse loop storage at O0; file-controlled iterations must not grow the stack.
    var program: ptr<IrBytecodeProgram>;
    var limits: ptr<IrBytecodeLimits>;
    var result: ptr<IrBytecodeResult>;
    var total: u64;
    var remaining: u64;
    var i: u64;
    var node: ptr<IrVerifyType>;
    var info: ptr<IrBytecodeType>;
    var width: u64;
    var child: ptr<IrBytecodeType>;
    var j: u64;
    var aligned: u64;
    var signature: u64;
    var expanded: u64;

    program = context.program;
    limits = context.limits;
    result = context.result;
    total = 0;
    remaining = limits.max_workspace_bytes - result.decoded_bytes - result.scratch_words * 8;
    if (context.owned_bytes > remaining) { return ir_bytecode_fail(result, 2, 6, 11, 0); }
    remaining -= context.owned_bytes;
    i = 0;
    while (i < program.type_count) {
        if (!ir_bytecode_charge(result, limits, 1)) { return false; }
        node = &program.types[i];
        info = &context.types[i];
        info.size = 0;
        info.align = 1;
        info.depth = 1;
        info.expanded = 1;
        info.storable = 0;
        width = ir_verify_width(node.kind);
        if (node.kind >= 1 && node.kind <= 16) {
            info.size = width / 8;
            if (node.kind == 1 || width == 1) { info.size = 1; }
            info.align = info.size;
            info.storable = 1;
        } else if (node.kind == 17 || node.kind == 19) {
            child = &context.types[node.child];
            info.depth = child.depth + 1;
            info.expanded += child.expanded;
            if (node.kind == 17) {
                info.size = 8;
                info.align = 8;
                info.storable = 1;
            } else if (child.storable == 1
                && (node.count == 0 || child.size <= 18446744073709551615 / node.count)) {
                info.size = child.size * node.count;
                info.align = child.align;
                info.storable = 1;
            }
        } else if (node.kind >= 18) {
            info.storable = 1;
            j = 0;
            while (j < node.count) {
                if (!ir_bytecode_charge(result, limits, 1)) { return false; }
                child = &context.types[program.edges[node.first + j]];
                if (child.expanded > remaining / 512
                    || info.expanded > remaining / 512 - child.expanded) {
                    return ir_bytecode_fail(result, 2, 6, 1, i);
                }
                info.expanded += child.expanded;
                if (child.depth + 1 > info.depth) { info.depth = child.depth + 1; }
                if (node.kind != 18) {
                    if (child.storable == 0) { info.storable = 0; }
                    aligned = 0;
                    if (!ir_align_up(info.size, child.align, &aligned)
                        || child.size > 18446744073709551615 - aligned) {
                        info.storable = 0;
                    } else {
                        info.size = aligned + child.size;
                    }
                    if (child.align > info.align) { info.align = child.align; }
                }
                j += 1;
            }
            if (node.kind == 18) {
                info.size = 8;
                info.align = 8;
            } else {
                aligned = 0;
                if (!ir_align_up(info.size, info.align, &aligned)) { info.storable = 0; }
                info.size = aligned;
            }
        }
        if (info.expanded > remaining / 512 || total > remaining / 512 - info.expanded) {
            return ir_bytecode_fail(result, 2, 6, 1, i);
        }
        total += info.expanded;
        i += 1;
    }
    i = 0;
    while (i < program.function_count) {
        if (!ir_bytecode_charge(result, limits, 1)) { return false; }
        signature = program.functions[i].signature;
        if (signature >= program.type_count) { return ir_bytecode_fail(result, 1, 80, 3, i); }
        expanded = context.types[signature].expanded;
        if (expanded > remaining / 512 || total > remaining / 512 - expanded) {
            return ir_bytecode_fail(result, 2, 6, 3, i);
        }
        total += expanded;
        i += 1;
    }
    context.owned_bytes += total * 512;
    return true;
}

// SPDX-License-Identifier: MPL-2.0
// Tokenization is native; allocation and public Rust enum construction are adapters.
fun asm_lex_error(c: ptr<AsmLexCursor>, status: u64, reason: u64,
    start: u64, line: u64, column: u64, detail: u64) -> bool {
    c.result.status = status;
    c.result.reason = reason;
    c.result.start = start;
    c.result.end = c.at;
    c.result.line = line;
    c.result.column = column;
    c.result.detail = detail;
    c.result.work = c.work;
    return false;
}

fun asm_lex_charge(c: ptr<AsmLexCursor>) -> bool {
    if (c.work >= c.max_work) {
        return asm_lex_error(c, 4, 0, c.at, c.line, c.column, 0);
    }
    c.work += 1;
    return true;
}

fun asm_lex_peek(c: ptr<AsmLexCursor>, cp: ptr<u64>, width: ptr<u64>) -> bool {
    if (c.at >= c.length) {
        return false;
    }
    var first: u64 = c.source[c.at] as u64;
    var count: u64 = 1;
    var minimum: u64 = 0;
    var value: u64 = first;
    if (first >= 194 && first <= 223) {
        count = 2;
        minimum = 128;
        value = first & 31;
    } else if (first >= 224 && first <= 239) {
        count = 3;
        minimum = 2048;
        value = first & 15;
    } else if (first >= 240 && first <= 244) {
        count = 4;
        minimum = 65536;
        value = first & 7;
    } else if (first >= 128) {
        return asm_lex_error(c, 5, 10, c.at, c.line, c.column, 0);
    }
    if (count > c.length - c.at) {
        return asm_lex_error(c, 5, 10, c.at, c.line, c.column, 0);
    }
    var i: u64 = 1;
    while (i < count) {
        var octet: u64 = c.source[c.at + i] as u64;
        if (octet < 128 || octet > 191) {
            return asm_lex_error(c, 5, 10, c.at, c.line, c.column, 0);
        }
        value = (value << 6) | (octet & 63);
        i += 1;
    }
    if (value < minimum || value > 1114111 || (value >= 55296 && value <= 57343)) {
        return asm_lex_error(c, 5, 10, c.at, c.line, c.column, 0);
    }
    cp[0] = value;
    width[0] = count;
    return true;
}

fun asm_lex_bump(c: ptr<AsmLexCursor>, cp: u64, width: u64) -> bool {
    if (!asm_lex_charge(c)) {
        return false;
    }
    c.at += width;
    if (cp == 13) {
        c.line += 1;
        c.column = 1;
        c.previous_cr = true;
    } else if (cp == 10) {
        if (!c.previous_cr) {
            c.line += 1;
        }
        c.column = 1;
        c.previous_cr = false;
    } else {
        c.column += 1;
        c.previous_cr = false;
    }
    return true;
}

fun asm_lex_identifier(cp: u64) -> bool {
    return cp == 95 || cp == 46 || asm_unicode_alphanumeric(cp);
}

fun asm_lex_digit(cp: u64, radix: u64) -> u64 {
    if (cp >= 48 && cp <= 57 && cp - 48 < radix) {
        return cp - 48;
    }
    if (radix == 16 && cp >= 65 && cp <= 70) {
        return cp - 55;
    }
    if (radix == 16 && cp >= 97 && cp <= 102) {
        return cp - 87;
    }
    return 18446744073709551615;
}

fun asm_lex_decoded(c: ptr<AsmLexCursor>, octet: u8, mode: u64,
    data: ptr<u8>, capacity: u64, maximum: u64) -> bool {
    if (c.result.decoded >= maximum) {
        return asm_lex_error(c, 3, 0, c.at, c.line, c.column, 0);
    }
    if (mode == 1) {
        if (c.result.decoded >= capacity) {
            return asm_lex_error(c, 5, 0, c.at, c.line, c.column, 0);
        }
        data[c.result.decoded] = octet;
    }
    c.result.decoded += 1;
    return true;
}

fun asm_lex_string(c: ptr<AsmLexCursor>, token: ptr<AsmToken>, mode: u64,
    decoded: ptr<u8>, capacity: u64, maximum: u64) -> bool {
    if (!asm_lex_bump(c, 34, 1)) {
        return false;
    }
    var cp: u64 = 0;
    var width: u64 = 0;
    var start: u64 = 0;
    var line: u64 = 0;
    var column: u64 = 0;
    var octet: u64 = 0;
    var i: u64 = 0;
    var digit: u64 = 0;
    var content: u64 = 0;
    while (true) {
        start = c.at;
        line = c.line;
        column = c.column;
        if (!asm_lex_peek(c, &cp, &width)) {
            if (c.result.status != 0) {
                return false;
            }
            return asm_lex_error(c, 1, 2, token.start, token.line, token.column, 0);
        }
        content = c.at;
        if (!asm_lex_bump(c, cp, width)) {
            return false;
        }
        if (cp == 34) {
            return true;
        }
        if (cp == 92) {
            if (!asm_lex_peek(c, &cp, &width)) {
                if (c.result.status != 0) {
                    return false;
                }
                return asm_lex_error(c, 1, 3, start, line, column, 0);
            }
            if (!asm_lex_bump(c, cp, width)) {
                return false;
            }
            octet = cp;
            if (cp == 110) {
                octet = 10;
            } else if (cp == 114) {
                octet = 13;
            } else if (cp == 116) {
                octet = 9;
            } else if (cp == 48) {
                octet = 0;
            } else if (cp == 120) {
                octet = 0;
                i = 0;
                while (i < 2) {
                    if (!asm_lex_peek(c, &cp, &width)) {
                        if (c.result.status != 0) {
                            return false;
                        }
                        return asm_lex_error(c, 1, 4, start, line, column, 0);
                    }
                    if (!asm_lex_bump(c, cp, width)) {
                        return false;
                    }
                    digit = asm_lex_digit(cp, 16);
                    if (digit == 18446744073709551615) {
                        return asm_lex_error(c, 1, 5, start, line, column, 0);
                    }
                    octet = octet * 16 + digit;
                    i += 1;
                }
            } else if (cp != 34 && cp != 92) {
                return asm_lex_error(c, 1, 6, start, line, column, 0);
            }
            if (!asm_lex_decoded(c, octet as u8, mode, decoded, capacity, maximum)) {
                return false;
            }
        } else {
            i = 0;
            while (i < width) {
                if (!asm_lex_decoded(c, c.source[content + i], mode,
                    decoded, capacity, maximum)) {
                    return false;
                }
                i += 1;
            }
        }
    }
    return true;
}

export(c) fun whale_asm_lex(source: ptr<u8>, length: u64, max_tokens: u64,
    max_decoded: u64, max_work: u64, mode: u64,
    scratch_tokens: ptr<AsmToken>, token_capacity: u64,
    scratch_decoded: ptr<u8>, decoded_capacity: u64,
    output_tokens: ptr<AsmToken>, output_token_capacity: u64,
    output_decoded: ptr<u8>, output_decoded_capacity: u64,
    result: ptr<AsmLexResult>) -> i32 {
    if (result == null) {
        return 5;
    }
    result.status = 0;
    result.reason = 0;
    result.start = 0;
    result.end = 0;
    result.line = 1;
    result.column = 1;
    result.detail = 0;
    result.tokens = 0;
    result.decoded = 0;
    result.work = 0;
    if (mode > 1 || !asm_span_valid(source, length, 1)
        || (mode == 1 && (!asm_span_valid(scratch_tokens as ptr<u8>, token_capacity, 88)
        || !asm_span_valid(output_tokens as ptr<u8>, output_token_capacity, 88)
        || !asm_span_valid(scratch_decoded, decoded_capacity, 1)
        || !asm_span_valid(output_decoded, output_decoded_capacity, 1)))) {
        result.status = 5;
        return 5;
    }
    if (length > 8388608) {
        result.status = 6;
        return 6;
    }
    var c: AsmLexCursor;
    c.source = source;
    c.length = length;
    c.at = 0;
    c.line = 1;
    c.column = 1;
    c.previous_cr = false;
    c.work = 0;
    c.max_work = max_work;
    c.result = result;
    var cp: u64 = 0;
    var width: u64 = 0;
    var kind: u64 = 0;
    var radix: u64 = 0;
    var digits: u64 = 0;
    var digit: u64 = 0;
    var number: u64 = 0;
    var overflow: bool = false;
    var token: AsmToken;
    var i: u64 = 0;
    while (c.at < length) {
        if (!asm_lex_peek(&c, &cp, &width)) {
            return result.status as i32;
        }
        token.start = c.at;
        token.line = c.line;
        token.column = c.column;
        token.decoded_start = result.decoded;
        token.decoded_len = 0;
        token.low = 0;
        token.high = 0;
        if (cp == 59) {
            while (c.at < length && cp != 10 && cp != 13) {
                if (!asm_lex_bump(&c, cp, width)) {
                    return result.status as i32;
                }
                if (c.at < length && !asm_lex_peek(&c, &cp, &width)) {
                    return result.status as i32;
                }
            }
            continue;
        }
        if (cp == 32 || cp == 9) {
            if (!asm_lex_bump(&c, cp, width)) {
                return result.status as i32;
            }
            continue;
        }
        if (cp == 34) {
            kind = 2;
            if (!asm_lex_string(&c, &token, mode, scratch_decoded,
                decoded_capacity, max_decoded)) {
                return result.status as i32;
            }
            token.decoded_len = result.decoded - token.decoded_start;
        } else if (cp >= 48 && cp <= 57) {
            kind = 1;
            radix = 10;
            if (cp == 48 && c.at + 1 < length) {
                if (source[c.at + 1] == 120 || source[c.at + 1] == 88) {
                    radix = 16;
                } else if (source[c.at + 1] == 98 || source[c.at + 1] == 66) {
                    radix = 2;
                }
            }
            if (radix != 10) {
                if (!asm_lex_bump(&c, cp, 1)
                    || !asm_lex_bump(&c, source[c.at] as u64, 1)) {
                    return result.status as i32;
                }
            }
            digits = c.at;
            number = 0;
            overflow = false;
            while (c.at < length) {
                if (!asm_lex_peek(&c, &cp, &width)) {
                    return result.status as i32;
                }
                digit = asm_lex_digit(cp, radix);
                if (digit == 18446744073709551615) {
                    break;
                }
                if (number > (18446744073709551615 - digit) / radix) {
                    overflow = true;
                } else {
                    number = number * radix + digit;
                }
                if (!asm_lex_bump(&c, cp, width)) {
                    return result.status as i32;
                }
            }
            if (digits == c.at) {
                result.reason = 7;
                if (radix == 2) {
                    result.reason = 8;
                }
                asm_lex_error(&c, 1, result.reason, token.start, token.line, token.column, 0);
                return 1;
            }
            if (overflow) {
                asm_lex_error(&c, 1, 9, token.start, token.line, token.column, 0);
                return 1;
            }
            token.low = number;
        } else if (asm_lex_identifier(cp)) {
            kind = 0;
            while (c.at < length && asm_lex_identifier(cp)) {
                if (!asm_lex_bump(&c, cp, width)) {
                    return result.status as i32;
                }
                if (c.at < length && !asm_lex_peek(&c, &cp, &width)) {
                    return result.status as i32;
                }
            }
        } else {
            kind = 18446744073709551615;
            if (cp == 44) {
                kind = 3;
            } else if (cp == 58) {
                kind = 4;
            } else if (cp == 91) {
                kind = 5;
            } else if (cp == 93) {
                kind = 6;
            } else if (cp == 43) {
                kind = 7;
            } else if (cp == 45) {
                kind = 8;
            } else if (cp == 42) {
                kind = 9;
            } else if (cp == 10 || cp == 13) {
                kind = 11;
            }
            if (kind == 18446744073709551615) {
                asm_lex_error(&c, 1, 1, c.at, c.line, c.column, cp);
                result.end = c.at + width;
                return 1;
            }
            if (!asm_lex_bump(&c, cp, width)) {
                return result.status as i32;
            }
            if (cp == 13 && c.at < length && source[c.at] == 10) {
                if (!asm_lex_bump(&c, 10, 1)) {
                    return result.status as i32;
                }
            }
        }
        token.kind = kind;
        token.end = c.at;
        token.end_line = c.line;
        token.end_column = c.column;
        if (result.tokens >= max_tokens) {
            asm_lex_error(&c, 2, 0, token.start, token.line, token.column, 0);
            return 2;
        }
        if (mode == 1) {
            if (result.tokens >= token_capacity) {
                asm_lex_error(&c, 5, 0, token.start, token.line, token.column, 0);
                return 5;
            }
            scratch_tokens[result.tokens] = token;
        }
        result.tokens += 1;
    }
    result.work = c.work;
    if (mode == 1) {
        if (result.tokens > output_token_capacity || result.decoded > output_decoded_capacity) {
            result.status = 5;
            return 5;
        }
        i = 0;
        while (i < result.tokens) {
            output_tokens[i] = scratch_tokens[i];
            i += 1;
        }
        i = 0;
        while (i < result.decoded) {
            output_decoded[i] = scratch_decoded[i];
            i += 1;
        }
    }
    return 0;
}

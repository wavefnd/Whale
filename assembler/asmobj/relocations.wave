// Namespace and format selection belongs to the assembler/object bridge.
// Generic object validation and serialization remain owned by the object module.
fun asmobj_literal_equal(state: ptr<AsmobjState>, data: ptr<u8>, count: u64,
    literal: ptr<u8>, literal_len: u64) -> bool {
    return asmobj_names_equal(state, data, count, literal, literal_len);
}

fun asmobj_relocation_kind(state: ptr<AsmobjState>, target: ptr<AsmobjTarget>,
    relocation: ptr<AsmobjRelocation>, undefined: u64, kind: ptr<u64>, code: ptr<u64>) -> i32 {
    kind[0] = relocation.kind;
    code[0] = 0;
    if (relocation.kind == 4) {
        if (target.format == 2) {
            kind[0] = 8;
            code[0] = 2;
        } else if (undefined == 0) {
            kind[0] = 3;
        }
        return 0;
    }
    if (relocation.kind != 6) { return 0; }
    var machine: u64 = 18446744073709551615;
    if (asmobj_literal_equal(state, relocation.namespace, relocation.namespace_len,
        "aarch64" as ptr<u8>, 7)) {
        machine = 1;
    } else if (asmobj_literal_equal(state, relocation.namespace, relocation.namespace_len,
        "riscv64" as ptr<u8>, 7)) {
        machine = 2;
    } else if (asmobj_literal_equal(state, relocation.namespace, relocation.namespace_len,
        "loongarch64" as ptr<u8>, 11)) {
        machine = 3;
    }
    if (state.status != 0) { return state.status; }
    if (machine == 18446744073709551615) { return 3; }
    if (machine != target.machine) { return 4; }
    if (target.format == 0) {
        code[0] = relocation.code;
        return 0;
    }
    if (target.format == 2 && machine == 1 && (relocation.code == 282 || relocation.code == 283)) {
        kind[0] = 8;
        code[0] = 2;
        return 0;
    }
    if (target.format == 1 && machine == 1) {
        kind[0] = 7;
        if (relocation.code == 274) { code[0] = 5; }
        else if (relocation.code == 280) { code[0] = 15; }
        else if (relocation.code == 282 || relocation.code == 283) { code[0] = 3; }
        else { return 5; }
        return 0;
    }
    return 6;
}

fun asmobj_relocation_valid(relocation: ptr<AsmobjRelocation>, section_count: u64) -> bool {
    return relocation.section < section_count && relocation.kind <= 6
        && relocation.code <= 4294967295
        && asmobj_span_valid(relocation.name, relocation.name_len)
        && asmobj_span_valid(relocation.namespace, relocation.namespace_len);
}

fun asmobj_emit_relocation(source: ptr<AsmobjRelocation>, kind: u64, code: u64,
    output: ptr<AsmobjRelocation>) {
    output[0] = deref source;
    output.kind = kind;
    output.namespace = null;
    output.namespace_len = 0;
    output.code = code;
}

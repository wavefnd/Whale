// Fixed-width little-endian integer instruction fields.
fun loong_three(opcode: u64, rd: u64, rj: u64, rk: u64) -> u64 {
    return opcode | rd | (rj << 5) | (rk << 10);
}

fun loong_immediate(opcode: u64, rd: u64, rj: u64, immediate: u64) -> u64 {
    return opcode | rd | (rj << 5) | (immediate << 10);
}

fun loong_upper(opcode: u64, rd: u64, immediate: u64) -> u64 {
    return opcode | rd | ((immediate & 1048575) << 5);
}

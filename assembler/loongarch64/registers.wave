// ABI aliases and canonical numeric registers; dollar prefixes are optional.
fun loong_register_error(text: FixedText, result: ptr<FixedResult>) -> bool {
    asm_fixed_fail(result, 3000, text, 0);
    result.display = 1;
    return false;
}

fun loong_register(raw: FixedText, output: ptr<u64>, result: ptr<FixedResult>) -> bool {
    var text: FixedText = asm_fixed_trim(raw);
    if (text.count != 0 && text.data[0] == 36) {
        text.data = &text.data[1];
        text.count -= 1;
    }
    if (asm_fixed_word(text, 1869768058, 4, 1)) { // zero
        output[0] = 0;
        return true;
    }
    if (asm_fixed_word(text, 24946, 2, 1)) { // ra
        output[0] = 1;
        return true;
    }
    if (asm_fixed_word(text, 28788, 2, 1)) { // tp
        output[0] = 2;
        return true;
    }
    if (asm_fixed_word(text, 28787, 2, 1)) { // sp
        output[0] = 3;
        return true;
    }
    if (asm_fixed_word(text, 12385, 2, 1)) { // a0
        output[0] = 4;
        return true;
    }
    if (asm_fixed_word(text, 12641, 2, 1)) { // a1
        output[0] = 5;
        return true;
    }
    if (asm_fixed_word(text, 12897, 2, 1)) { // a2
        output[0] = 6;
        return true;
    }
    if (asm_fixed_word(text, 13153, 2, 1)) { // a3
        output[0] = 7;
        return true;
    }
    if (asm_fixed_word(text, 13409, 2, 1)) { // a4
        output[0] = 8;
        return true;
    }
    if (asm_fixed_word(text, 13665, 2, 1)) { // a5
        output[0] = 9;
        return true;
    }
    if (asm_fixed_word(text, 13921, 2, 1)) { // a6
        output[0] = 10;
        return true;
    }
    if (asm_fixed_word(text, 14177, 2, 1)) { // a7
        output[0] = 11;
        return true;
    }
    if (asm_fixed_word(text, 12404, 2, 1)) { // t0
        output[0] = 12;
        return true;
    }
    if (asm_fixed_word(text, 12660, 2, 1)) { // t1
        output[0] = 13;
        return true;
    }
    if (asm_fixed_word(text, 12916, 2, 1)) { // t2
        output[0] = 14;
        return true;
    }
    if (asm_fixed_word(text, 13172, 2, 1)) { // t3
        output[0] = 15;
        return true;
    }
    if (asm_fixed_word(text, 13428, 2, 1)) { // t4
        output[0] = 16;
        return true;
    }
    if (asm_fixed_word(text, 13684, 2, 1)) { // t5
        output[0] = 17;
        return true;
    }
    if (asm_fixed_word(text, 13940, 2, 1)) { // t6
        output[0] = 18;
        return true;
    }
    if (asm_fixed_word(text, 14196, 2, 1)) { // t7
        output[0] = 19;
        return true;
    }
    if (asm_fixed_word(text, 14452, 2, 1)) { // t8
        output[0] = 20;
        return true;
    }
    if (asm_fixed_word(text, 12405, 2, 1)) { // u0
        output[0] = 21;
        return true;
    }
    if (asm_fixed_word(text, 28774, 2, 1)) { // fp
        output[0] = 22;
        return true;
    }
    if (asm_fixed_word(text, 12403, 2, 1)) { // s0
        output[0] = 23;
        return true;
    }
    if (asm_fixed_word(text, 12659, 2, 1)) { // s1
        output[0] = 24;
        return true;
    }
    if (asm_fixed_word(text, 12915, 2, 1)) { // s2
        output[0] = 25;
        return true;
    }
    if (asm_fixed_word(text, 13171, 2, 1)) { // s3
        output[0] = 26;
        return true;
    }
    if (asm_fixed_word(text, 13427, 2, 1)) { // s4
        output[0] = 27;
        return true;
    }
    if (asm_fixed_word(text, 13683, 2, 1)) { // s5
        output[0] = 28;
        return true;
    }
    if (asm_fixed_word(text, 13939, 2, 1)) { // s6
        output[0] = 29;
        return true;
    }
    if (asm_fixed_word(text, 14195, 2, 1)) { // s7
        output[0] = 30;
        return true;
    }
    if (asm_fixed_word(text, 14451, 2, 1)) { // s8
        output[0] = 31;
        return true;
    }
    if (text.count < 2 || text.count > 3
        || (text.data[0] != 114 && text.data[0] != 82)) {
        return loong_register_error(text, result);
    }
    if (text.count > 2 && text.data[1] == 48) {
        return loong_register_error(text, result);
    }
    var number: u64 = 0;
    var at: u64 = 1;
    var octet: u64 = 0;
    while (at < text.count) {
        octet = text.data[at] as u64;
        if (octet < 48 || octet > 57) {
            return loong_register_error(text, result);
        }
        number = number * 10 + octet - 48;
        at += 1;
    }
    if (number >= 32) {
        return loong_register_error(text, result);
    }
    output[0] = number;
    return true;
}

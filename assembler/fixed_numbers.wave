// SPDX-License-Identifier: MPL-2.0
// Preserve the fixed-width assembly grammar's checked signed-i128 literals.
export(c) fun asm_fixed_integer(text: FixedText, output: ptr<AsmWide>,
    result: ptr<FixedResult>) -> bool {
    var value: FixedText = text;
    var negative: bool = false;
    var inner_negative: bool = false;
    var maximum_high: u64 = 9223372036854775807;
    var radix: u64 = 10;
    var at: u64 = 0;
    var next: u64 = 0;
    var digit: u64 = 0;
    var octet: u64 = 0;
    var low: u64 = 0;
    var high: u64 = 0;
    var lower: u64 = 0;
    var upper: u64 = 0;
    var digits: u64 = 0;
    var parsed: AsmWide;
    if (result.status != 0) {
        return false;
    }
    if (output == null || !asm_span_valid(text.data, text.count, 1)) {
        result.status = 2;
        return false;
    }
    if (!asm_fixed_charge(result, text.count + 1)) {
        return false;
    }
    value = asm_fixed_trim(text);
    if (value.count != 0 && value.data[0] == 35) {
        value = asm_fixed_trim(asm_fixed_slice(value, 1, value.count));
    }
    if (value.count != 0 && (value.data[0] == 43 || value.data[0] == 45)) {
        negative = value.data[0] == 45;
        value = asm_fixed_trim(asm_fixed_slice(value, 1, value.count));
    }
    if (value.count == 0 || value.data[0] < 48 || value.data[0] > 57) {
        return asm_fixed_fail(result, 2, value, 0);
    }
    if (value.data[0] == 48) {
        next = 1;
        while (next < value.count && value.data[next] == 95) {
            next += 1;
        }
        if (next < value.count && (value.data[next] == 120 || value.data[next] == 88)) {
            radix = 16;
            at = next + 1;
        } else if (next < value.count && (value.data[next] == 98 || value.data[next] == 66)) {
            radix = 2;
            at = next + 1;
        }
    }
    // from_str_radix accepts a sign after a radix prefix, including MIN.
    // The outer assembly sign is applied afterwards with checked negation.
    if (radix != 10) {
        while (at < value.count && value.data[at] == 95) {
            at += 1;
        }
        if (at < value.count && (value.data[at] == 43 || value.data[at] == 45)) {
            inner_negative = value.data[at] == 45;
            at += 1;
        }
        if (inner_negative) {
            maximum_high = 9223372036854775808;
        }
    }
    while (at < value.count) {
        octet = value.data[at] as u64;
        at += 1;
        if (octet != 95) {
            digit = asm_lex_digit(octet, radix);
            if (digit >= radix) {
                return asm_fixed_fail(result, 2, value, 0);
            }
            // Split multiplication avoids host-width arithmetic and unchecked carry.
            lower = (low & 4294967295) * radix + digit;
            upper = (low >> 32) * radix + (lower >> 32);
            if (high > (maximum_high - (upper >> 32)) / radix) {
                return asm_fixed_fail(result, 2, value, 0);
            }
            high = high * radix + (upper >> 32);
            low = (upper << 32) | (lower & 4294967295);
            digits += 1;
        }
    }
    if (digits == 0 || (high == 9223372036854775808 && low != 0)) {
        return asm_fixed_fail(result, 2, value, 0);
    }
    parsed.low = low;
    parsed.high = high;
    if (inner_negative) {
        parsed.low = ~low + 1;
        parsed.high = ~high + (parsed.low == 0) as u64;
    }
    if (negative && !asm_number_neg_checked(&parsed, &parsed)) {
        return asm_fixed_fail(result, 3, value, 0);
    }
    output[0] = parsed;
    return true;
}

export(c) fun asm_fixed_try_integer(text: FixedText, output: ptr<AsmWide>,
    result: ptr<FixedResult>) -> bool {
    var old_text: FixedText = result.text;
    var detail: u64 = result.detail;
    var display: u64 = result.display;
    if (result.status != 0) {
        return false;
    }
    if (asm_fixed_integer(text, output, result)) {
        return true;
    }
    if (result.status == 1 && (result.error == 2 || result.error == 3)) {
        result.status = 0;
        result.error = 0;
        result.text = old_text;
        result.detail = detail;
        result.display = display;
    }
    return false;
}

export(c) fun asm_fixed_signed(text: FixedText, bits: u64, output: ptr<u64>,
    result: ptr<FixedResult>) -> bool {
    var value: AsmWide;
    var one: u64 = 1;
    if (output == null) {
        result.status = 2;
        return false;
    }
    if (bits == 0 || bits > 32) {
        return asm_fixed_fail(result, 4, text, 0);
    }
    if (!asm_fixed_integer(text, &value, result)) {
        return false;
    }
    if (!asm_number_fits_signed(&value, bits)) {
        return asm_fixed_fail(result, 5, text, bits);
    }
    output[0] = value.low & ((one << bits) - 1);
    return true;
}

export(c) fun asm_fixed_unsigned(text: FixedText, bits: u64, output: ptr<u64>,
    result: ptr<FixedResult>) -> bool {
    var value: AsmWide;
    if (output == null) {
        result.status = 2;
        return false;
    }
    if (bits == 0 || bits > 32) {
        return asm_fixed_fail(result, 4, text, 0);
    }
    if (!asm_fixed_integer(text, &value, result)) {
        return false;
    }
    if (!asm_number_fits_unsigned(&value, bits)) {
        return asm_fixed_fail(result, 6, text, bits);
    }
    output[0] = value.low;
    return true;
}

export(c) fun asm_fixed_i64(text: FixedText, output: ptr<i64>,
    result: ptr<FixedResult>) -> bool {
    var value: AsmWide;
    if (output == null) {
        result.status = 2;
        return false;
    }
    if (!asm_fixed_integer(text, &value, result)) {
        return false;
    }
    if (!asm_number_fits_signed(&value, 64)) {
        return asm_fixed_fail(result, 14, text, 0);
    }
    output[0] = value.low as i64;
    return true;
}

export(c) fun asm_fixed_displacement(value: i64, bits: u64, alignment: i64,
    output: ptr<u64>, result: ptr<FixedResult>) -> bool {
    var scaled: i64 = 0;
    var one: u64 = 1;
    if (output == null) {
        result.status = 2;
        return false;
    }
    if (bits == 0 || bits > 32 || alignment <= 0) {
        return asm_fixed_fail(result, 7, result.text, 0);
    }
    if (value % alignment != 0) {
        return asm_fixed_fail(result, 8, result.text, alignment as u64);
    }
    scaled = value / alignment;
    if (scaled < -((one << (bits - 1)) as i64)
        || scaled >= (one << (bits - 1)) as i64) {
        return asm_fixed_fail(result, 9, result.text, bits);
    }
    output[0] = (scaled as u64) & ((one << bits) - 1);
    return true;
}

export(c) fun asm_fixed_identifier(text: FixedText, result: ptr<FixedResult>) -> bool {
    var at: u64 = 0;
    var octet: u64 = 0;
    if (!asm_span_valid(text.data, text.count, 1)) {
        result.status = 2;
        return false;
    }
    if (!asm_fixed_charge(result, text.count + 1)) {
        return false;
    }
    if (text.count == 0) {
        return asm_fixed_fail(result, 11, text, 0);
    }
    while (at < text.count) {
        octet = text.data[at] as u64;
        if (!((octet >= 65 && octet <= 90) || (octet >= 97 && octet <= 122)
            || octet == 95 || octet == 46 || octet == 36
            || (at != 0 && octet >= 48 && octet <= 57))) {
            return asm_fixed_fail(result, 11, text, 0);
        }
        at += 1;
    }
    return true;
}

// Complete AMD64 statement grammar with caller-owned transactional output.
fun amd64_item_clear(item: ptr<AsmItem>) {
    item.kind = 0;
    item.name = 18446744073709551615;
    item.aux = 0;
    item.flags = 0;
    amd64_expr_clear(&item.expression);
    item.first = 0;
    item.count = 0;
}

fun amd64_parse_instruction(p: ptr<AsmParser>, item: ptr<AsmItem>) -> bool {
    var mnemonic: u64 = p.position;
    item.kind = 0;
    if (!amd64_parse_name(p, mnemonic, true, &item.name)) {
        return false;
    }
    p.position += 1;
    if (p.position < p.packet.count && amd64_token_kind(p, p.position) != 11) {
        var name: ptr<AsmName> = &p.packet.tokens[mnemonic].text;
        if (amd64_name_is(name, 6584163, 3, 1) // cwd
            || amd64_name_is(name, 7431267, 3, 1) // cdq
            || amd64_name_is(name, 7303523, 3, 1)) { // cqo
            p.result.detail = 0;
            if (amd64_name_is(name, 7431267, 3, 1)) { // cdq
                p.result.detail = 1;
            } else if (amd64_name_is(name, 7303523, 3, 1)) { // cqo
                p.result.detail = 2;
            }
            return amd64_parse_fail(p, 5, p.position);
        }
    }
    item.first = p.result.operands;
    if (p.position < p.packet.count && amd64_token_kind(p, p.position) != 11) {
        while (true) {
            var operand: AsmOperand;
            if (!amd64_parse_operand(p, &operand) || !amd64_emit_operand(p, &operand)) {
                return false;
            }
            if (amd64_token_kind(p, p.position) != 3) {
                break;
            }
            var comma: u64 = p.position;
            p.position += 1;
            var next: u64 = amd64_token_kind(p, p.position);
            if (next == 18446744073709551615 || next == 11) {
                return amd64_parse_fail(p, 8, comma);
            }
        }
    }
    item.count = p.result.operands - item.first;
    return amd64_finish_statement(p);
}

fun amd64_parse_constant(p: ptr<AsmParser>, item: ptr<AsmItem>) -> bool {
    item.kind = 8;
    if (!amd64_parse_name(p, p.position, false, &item.name)) {
        return false;
    }
    p.position += 2;
    if (!amd64_parse_expression(p, 0, &item.expression)) {
        return false;
    }
    while (amd64_token_kind(p, p.position) == 11) {
        if (!amd64_parse_charge(p, 1)) {
            return false;
        }
        p.position += 1;
    }
    return true;
}

export(c) fun whale_amd64_parse(packet: ptr<AsmParseInput>, output: ptr<AsmParseOutput>,
    result: ptr<AsmParseResult>) -> i32 {
    if (result == null) {
        return 2;
    }
    result.status = 2;
    result.error = 0;
    result.index = 0;
    result.detail = 0;
    result.items = 0;
    result.operands = 0;
    result.values = 0;
    result.names = 0;
    result.bytes = 0;
    result.work = 0;
    if (packet == null || output == null || packet.mode > 1
        || !asm_span_valid(packet.tokens as ptr<u8>, packet.count, 56)) {
        return 2;
    }
    if (packet.mode != 0
        && (!asm_span_valid(output.items as ptr<u8>, output.item_capacity, 80)
            || !asm_span_valid(output.spans as ptr<u8>, output.span_capacity, 16)
            || !asm_span_valid(output.operands as ptr<u8>, output.operand_capacity, 88)
            || !asm_span_valid(output.values as ptr<u8>, output.value_capacity, 56)
            || !asm_span_valid(output.names as ptr<u8>, output.name_capacity, 16)
            || !asm_span_valid(output.bytes, output.byte_capacity, 1))) {
        return 2;
    }
    var parser: AsmParser;
    parser.packet = packet;
    parser.output = output;
    parser.result = result;
    parser.position = 0;
    result.status = 0;
    var index: u64 = 0;
    while (index < packet.count) {
        var token: ptr<AsmParseToken> = &packet.tokens[index];
        if (!amd64_parse_charge(&parser, 1)) {
            return result.status as i32;
        }
        if (token.kind > 11 || !asm_span_valid(token.text.bytes, token.text.count, 1)) {
            result.status = 2;
            result.index = index;
            return 2;
        }
        index += 1;
    }
    while (parser.position < packet.count) {
        if (!amd64_parse_charge(&parser, 1)) {
            return result.status as i32;
        }
        var start: u64 = parser.position;
        var kind: u64 = amd64_token_kind(&parser, start);
        if (kind == 11) {
            parser.position += 1;
            continue;
        }
        if (kind != 0) {
            amd64_parse_fail(&parser, 2, start);
            return 1;
        }
        var item: AsmItem;
        amd64_item_clear(&item);
        if (amd64_token_kind(&parser, start + 1) == 4) {
            item.kind = 3;
            if (!amd64_parse_name(&parser, start, false, &item.name)) {
                return result.status as i32;
            }
            parser.position += 2;
        } else if (amd64_token_is(&parser, start + 1, 7696741, 3)) { // equ
            if (!amd64_parse_constant(&parser, &item)) {
                return result.status as i32;
            }
        } else if (amd64_directive_tag(&packet.tokens[start].text) != 0) {
            if (!amd64_parse_directive(&parser, &item)) {
                return result.status as i32;
            }
        } else if (!amd64_parse_instruction(&parser, &item)) {
            return result.status as i32;
        }
        var end: u64 = parser.position;
        while (end > start && packet.tokens[end - 1].kind == 11) {
            end -= 1;
        }
        if (end == start) {
            amd64_parse_backend(&parser);
            return 2;
        }
        if (packet.mode != 0) {
            if (result.items >= output.item_capacity || result.items >= output.span_capacity) {
                amd64_parse_backend(&parser);
                return 2;
            }
            output.items[result.items] = item;
            output.spans[result.items].start = start;
            output.spans[result.items].end = end;
        }
        result.items += 1;
    }
    return 0;
}

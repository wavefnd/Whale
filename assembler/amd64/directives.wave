// SPDX-License-Identifier: MPL-2.0
// Directives retain their expression and byte payloads for later assembly passes.
fun amd64_directive_tag(name: ptr<AsmName>) -> u64 {
    if (amd64_name_is(name, 119225648511347, 6, 1)) { // symbol
        return 1;
    }
    if (amd64_name_is(name, 31084746153092467, 7, 1)) { // section
        return 2;
    }
    if (amd64_name_is(name, 119165519096935, 6, 1)) { // global
        return 3;
    }
    if (amd64_name_is(name, 121437607458917, 6, 1)) { // extern
        return 4;
    }
    if (amd64_name_is(name, 474181364833, 5, 1) // align
        || amd64_name_is(name, 25188, 2, 1) // db
        || amd64_name_is(name, 30564, 2, 1) // dw
        || amd64_name_is(name, 25700, 2, 1) // dd
        || amd64_name_is(name, 29028, 2, 1) // dq
        || amd64_name_is(name, 1651729778, 4, 1) // resb
        || amd64_name_is(name, 2004051314, 4, 1) // resw
        || amd64_name_is(name, 1685284210, 4, 1) // resd
        || amd64_name_is(name, 1903388018, 4, 1)) { // resq
        return 5;
    }
    return 0;
}

fun amd64_parse_comma(p: ptr<AsmParser>) -> bool {
    if (amd64_token_kind(p, p.position) != 3) {
        return amd64_parse_fail(p, 21, p.position);
    }
    p.position += 1;
    return true;
}

fun amd64_parse_directive(p: ptr<AsmParser>, item: ptr<AsmItem>) -> bool {
    var start: u64 = p.position;
    var tag: u64 = amd64_directive_tag(&p.packet.tokens[start].text);
    p.position += 1;
    if (tag == 1) {
        item.kind = 1;
        if (amd64_token_kind(p, p.position) != 0) {
            return amd64_parse_fail(p, 20, p.position);
        }
        if (!amd64_parse_name(p, p.position, false, &item.name)) {
            return false;
        }
        p.position += 1;
        if (!amd64_parse_comma(p)) {
            return false;
        }
        if (amd64_token_is(p, p.position, 7957695015192261990, 8)) { // function
            item.aux = 1;
        } else if (amd64_token_is(p, p.position, 127970252055151, 6)) { // object
            item.aux = 2;
        } else if (amd64_token_is(p, p.position, 111533748416366, 6)) { // notype
            item.aux = 0;
        } else {
            return amd64_parse_fail(p, 22, p.position);
        }
        p.position += 1;
        if (!amd64_parse_comma(p) || !amd64_parse_expression(p, 1, &item.expression)
            || !amd64_parse_comma(p)) {
            return false;
        }
        if (amd64_token_is(p, p.position, 32770348699510116, 7)) { // default
            item.flags = 0;
        } else if (amd64_token_is(p, p.position, 121381755054440, 6)) { // hidden
            item.flags = 1;
        } else {
            return amd64_parse_fail(p, 23, p.position);
        }
        p.position += 1;
        return amd64_finish_statement(p);
    }
    if (tag >= 2 && tag <= 4) {
        if (amd64_token_kind(p, p.position) != 0) {
            return amd64_parse_fail(p, 24, p.position);
        }
        if (!amd64_parse_name(p, p.position, false, &item.name)) {
            return false;
        }
        p.position += 1;
        item.kind = 4;
        if (tag == 3) {
            item.kind = 6;
        } else if (tag == 4) {
            item.kind = 7;
        }
        if (tag == 2 && amd64_token_kind(p, p.position) == 3) {
            p.position += 1;
            item.kind = 5;
            if (amd64_token_is(p, p.position, 1954047348, 4)) { // text
                item.aux = 0;
            } else if (amd64_token_is(p, p.position, 1635017060, 4)) { // data
                item.aux = 1;
            } else if (amd64_token_is(p, p.position, 107152478072690, 6)) { // rodata
                item.aux = 2;
            } else if (amd64_token_is(p, p.position, 7566178, 3)) { // bss
                item.aux = 3;
            } else {
                return amd64_parse_fail(p, 25, p.position);
            }
            p.position += 1;
        }
        return amd64_finish_statement(p);
    }
    if (tag != 5) {
        return amd64_parse_backend(p);
    }
    item.kind = 2;
    if (!amd64_parse_name(p, start, true, &item.name)) {
        return false;
    }
    item.first = p.result.values;
    while (true) {
        if (!amd64_parse_charge(p, 1)) {
            return false;
        }
        var kind: u64 = amd64_token_kind(p, p.position);
        if (kind == 18446744073709551615 || kind == 11) {
            return amd64_parse_fail(p, 26, p.position);
        }
        var value: AsmDirectiveValue;
        value.kind = 0;
        value.bytes = null;
        value.count = 0;
        amd64_expr_clear(&value.expression);
        if (kind == 2) {
            value.kind = 1;
            value.bytes = p.packet.tokens[p.position].text.bytes;
            value.count = p.packet.tokens[p.position].text.count;
            p.position += 1;
        } else if (!amd64_parse_expression(p, 1, &value.expression)) {
            return false;
        }
        if (p.packet.mode != 0) {
            if (p.result.values >= p.output.value_capacity) {
                return amd64_parse_backend(p);
            }
            p.output.values[p.result.values] = value;
        }
        p.result.values += 1;
        if (amd64_token_kind(p, p.position) != 3) {
            break;
        }
        var comma: u64 = p.position;
        p.position += 1;
        kind = amd64_token_kind(p, p.position);
        if (kind == 18446744073709551615 || kind == 11) {
            return amd64_parse_fail(p, 27, comma);
        }
    }
    item.count = p.result.values - item.first;
    return amd64_finish_statement(p);
}

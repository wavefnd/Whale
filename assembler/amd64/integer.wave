// Integer instruction forms. Register and memory policies are shared helpers.
fun amd_memory_immediate(w: ptr<AmdWriter>, mem: ptr<AmdOperand>, imm: ptr<AmdOperand>,
    operation: u64) -> bool {
    var width: u64 = mem.memwidth;
    if (width == 18446744073709551615) {
        return amd_fail(w.result, 19);
    }
    var encoded_width: u64 = width;
    if (width == 64) {
        encoded_width = 32;
    }
    if (!amd_fits(imm.low, imm.high, encoded_width, width == 64)) {
        return amd_fail(w.result, 20);
    }
    var short: bool = operation != 18446744073709551615 && width != 8
        && amd_fits(imm.low, imm.high, 8, true);
    var tail: u64 = encoded_width / 8;
    var opcode: u64 = 199;
    if (operation == 18446744073709551615) {
        if (width == 8) {
            opcode = 198;
        }
        operation = 0;
    } else {
        opcode = 129;
        if (width == 8) {
            opcode = 128;
        } else if (short) {
            opcode = 131;
        }
    }
    if (short) {
        tail = 1;
    }
    var group: AmdOperand;
    group.code = operation;
    group.flags = 0;
    return amd_prefix(w, width) && amd_memory(w, opcode, 0, &group, mem, width, tail)
        && amd_emit(w, imm.low, tail);
}

fun amd_mov(w: ptr<AmdWriter>, a: ptr<AmdOperand>, b: ptr<AmdOperand>) -> bool {
    if (a.kind == 0 && a.width != 128) {
        if (b.kind == 1) {
            if (!amd_fits(b.low, b.high, a.width, false)) {
                w.result.argument = a.width;
                return amd_fail(w.result, 21);
            }
            var opcode: u64 = 184;
            if (a.width == 8) {
                opcode = 176;
            }
            return amd_prefix(w, a.width)
                && amd_rex(w, a.width, 0, 0, (a.code >= 8) as u64, a.flags)
                && amd_emit(w, opcode + (a.code & 7), 1) && amd_emit(w, b.low, a.width / 8);
        }
        if (b.kind == 2 || b.kind == 3) {
            if (a.width != 32 && a.width != 64) {
                return amd_fail(w.result, 22);
            }
            if (!amd_signed64(b.low, b.high)) {
                return amd_fail(w.result, 23);
            }
            if (!amd_rex(w, a.width, 0, 0, (a.code >= 8) as u64, 0)
                || !amd_emit(w, 184 + (a.code & 7), 1)) {
                return false;
            }
            var kind: u64 = 0;
            if (a.width == 32) {
                kind = 1;
            }
            return amd_relocation(w, b.symbol, kind, b.low, w.count)
                && amd_emit(w, 0, a.width / 8);
        }
        if (b.kind == 0) {
            var opcode: u64 = 137;
            if (a.width == 8) {
                opcode = 136;
            }
            return amd_register_pair(w, opcode, a, b);
        }
        if (b.kind == 4) {
            var opcode: u64 = 139;
            if (a.width == 8) {
                opcode = 138;
            }
            return amd_reg_mem(w, opcode, 0, a, b);
        }
    }
    if (a.kind == 4 && b.kind == 0) {
        var opcode: u64 = 137;
        if (b.width == 8) {
            opcode = 136;
        }
        return amd_reg_mem(w, opcode, 0, b, a);
    }
    if (a.kind == 4 && b.kind == 1) {
        return amd_memory_immediate(w, a, b, 18446744073709551615);
    }
    return amd_fail(w.result, 24);
}

fun amd_binary(w: ptr<AmdWriter>, a: ptr<AmdOperand>, b: ptr<AmdOperand>,
    opcode: u64, extension: u64) -> bool {
    if (a.kind == 0 && a.width != 128) {
        if (b.kind == 0) {
            var selected: u64 = opcode + 1;
            if (a.width == 8) {
                selected = opcode;
            }
            return amd_register_pair(w, selected, a, b);
        }
        if (b.kind == 1) {
            var width: u64 = a.width;
            var tail: u64 = width / 8;
            var selected: u64 = 129;
            if (width == 64) {
                tail = 4;
            }
            if (!amd_fits(b.low, b.high, tail * 8, width == 64)) {
                w.result.argument = width;
                return amd_fail(w.result, 21);
            }
            if (width == 8) {
                selected = 128;
            } else if (amd_fits(b.low, b.high, 8, true)) {
                selected = 131;
                tail = 1;
            }
            return amd_prefix(w, width)
                && amd_rex(w, width, 0, 0, (a.code >= 8) as u64, a.flags)
                && amd_emit(w, selected, 1) && amd_modrm(w, 3, extension, a.code)
                && amd_emit(w, b.low, tail);
        }
        if (b.kind == 2 || b.kind == 3) {
            return amd_fail(w.result, 25);
        }
        if (b.kind == 4) {
            var selected: u64 = opcode + 3;
            if (a.width == 8) {
                selected = opcode + 2;
            }
            return amd_reg_mem(w, selected, 0, a, b);
        }
    }
    if (a.kind == 4 && b.kind == 0) {
        var selected: u64 = opcode + 1;
        if (b.width == 8) {
            selected = opcode;
        }
        return amd_reg_mem(w, selected, 0, b, a);
    }
    if (a.kind == 4 && b.kind == 1) {
        return amd_memory_immediate(w, a, b, extension);
    }
    return amd_fail(w.result, 26);
}

fun amd_group(w: ptr<AmdWriter>, operand: ptr<AmdOperand>, width: u64,
    rex_width: u64, opcode: u64, two: u64, extension: u64) -> bool {
    if (!amd_prefix(w, width)) {
        return false;
    }
    if (operand.kind == 0 && operand.width != 128) {
        if (operand.width != width) {
            return amd_fail(w.result, 27);
        }
        if (!amd_rex(w, rex_width, 0, 0, (operand.code >= 8) as u64, operand.flags)) {
            return false;
        }
        if (two != 0 && !amd_emit(w, 15, 1)) {
            return false;
        }
        return amd_emit(w, opcode, 1) && amd_modrm(w, 3, extension, operand.code);
    }
    if (operand.kind == 4) {
        var group: AmdOperand;
        group.code = extension;
        group.flags = 0;
        return amd_mem_width(w, operand, width)
            && amd_memory(w, opcode, two, &group, operand, rex_width, 0);
    }
    return amd_fail(w.result, 28);
}

fun amd_extension(w: ptr<AmdWriter>, operation: u64, a: ptr<AmdOperand>,
    b: ptr<AmdOperand>) -> bool {
    if (a.kind != 0 || a.width == 128) {
        return amd_fail(w.result, 5);
    }
    var source_width: u64 = b.width;
    if (b.kind == 4) {
        source_width = b.memwidth;
        if (source_width == 18446744073709551615) {
            return amd_fail(w.result, 29);
        }
    } else if (b.kind != 0 || b.width == 128) {
        return amd_fail(w.result, 30);
    }
    var valid: bool = (source_width == 8 && (a.width == 16 || a.width == 32 || a.width == 64))
        || (source_width == 16 && (a.width == 32 || a.width == 64));
    if (operation == 31) {
        valid = a.width == 64 && source_width == 32;
    }
    if (!valid) {
        return amd_fail(w.result, 31);
    }
    var opcode: u64 = 182;
    var two: u64 = 1;
    if (source_width == 16) {
        opcode += 1;
    }
    if (operation == 30) {
        opcode += 8;
    }
    if (operation == 31) {
        opcode = 99;
        two = 0;
    }
    if (!amd_prefix(w, a.width)) {
        return false;
    }
    if (b.kind == 4) {
        return amd_memory(w, opcode, two, a, b, a.width, 0);
    }
    if (!amd_rex(w, a.width, (a.code >= 8) as u64, 0, (b.code >= 8) as u64, b.flags)) {
        return false;
    }
    if (two != 0 && !amd_emit(w, 15, 1)) {
        return false;
    }
    return amd_emit(w, opcode, 1) && amd_modrm(w, 3, a.code, b.code);
}

fun amd_imul(w: ptr<AmdWriter>, a: ptr<AmdOperand>, b: ptr<AmdOperand>,
    c: ptr<AmdOperand>, count: u64) -> bool {
    if (a.kind != 0 || a.width == 8 || a.width == 128) {
        return amd_fail(w.result, 32);
    }
    if (count == 3) {
        if (b.kind != 0 || a.width != b.width || b.width == 128) {
            return amd_fail(w.result, 33);
        }
        if (c.kind != 1) {
            return amd_fail(w.result, 34);
        }
        var tail: u64 = 4;
        if (a.width == 16) {
            tail = 2;
        }
        if (!amd_fits(c.low, c.high, tail * 8, a.width == 64)) {
            return amd_fail(w.result, 35);
        }
        var opcode: u64 = 105;
        if (amd_fits(c.low, c.high, 8, true)) {
            opcode = 107;
            tail = 1;
        }
        return amd_prefix(w, a.width)
            && amd_rex(w, a.width, (a.code >= 8) as u64, 0, (b.code >= 8) as u64, 0)
            && amd_emit(w, opcode, 1) && amd_modrm(w, 3, a.code, b.code)
            && amd_emit(w, c.low, tail);
    }
    if (b.kind == 4) {
        return amd_reg_mem(w, 175, 1, a, b);
    }
    if (b.kind != 0 || a.width != b.width || b.width == 128) {
        return amd_fail(w.result, 6);
    }
    return amd_prefix(w, a.width)
        && amd_rex(w, a.width, (a.code >= 8) as u64, 0, (b.code >= 8) as u64, 0)
        && amd_emit(w, 15, 1) && amd_emit(w, 175, 1) && amd_modrm(w, 3, a.code, b.code);
}

fun amd_shift(w: ptr<AmdWriter>, operation: u64, a: ptr<AmdOperand>,
    b: ptr<AmdOperand>) -> bool {
    if (a.kind != 0 || a.width == 128) {
        return amd_fail(w.result, 5);
    }
    var opcode: u64 = 208;
    var tail: u64 = 0;
    if (b.kind == 1 && b.high == 0 && b.low <= 255) {
        if (b.low != 1) {
            opcode = 192;
            tail = 1;
        }
    } else if (b.kind == 0 && b.code == 1 && b.width == 8 && b.flags == 0) {
        opcode = 210;
    } else {
        return amd_fail(w.result, 36);
    }
    if (a.width != 8) {
        opcode += 1;
    }
    var extension: u64 = 4;
    if (operation == 24) {
        extension = 5;
    } else if (operation == 25) {
        extension = 7;
    }
    return amd_prefix(w, a.width)
        && amd_rex(w, a.width, 0, 0, (a.code >= 8) as u64, a.flags)
        && amd_emit(w, opcode, 1) && amd_modrm(w, 3, extension, a.code)
        && amd_emit(w, b.low, tail);
}

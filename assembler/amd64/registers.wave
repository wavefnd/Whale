export(c) fun whale_amd64_register(name: ptr<AsmName>, fold: u64,
    output: ptr<Amd64Register>) -> i32 {
    if (name == null || output == null || fold > 1
        || !asm_span_valid(name.bytes, name.count, 1)) {
        return 2;
    }
    output.kind = 0;
    output.code = 0;
    output.width = 0;
    output.high8 = 0;
    output.rex8 = 0;
    if (amd64_register(name, fold, output)) {
        return 0;
    }
    return 1;
}

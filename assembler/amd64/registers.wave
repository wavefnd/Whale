// Register classification is shared by parsing and native encoding.
struct Amd64Register {
    kind: u64;
    code: u64;
    width: u64;
    high8: u64;
    rex8: u64;
}

fun amd64_lower_byte(value: u8) -> u8 {
    if (value >= 65 && value <= 90) {
        return value + 32;
    }
    return value;
}

fun amd64_name_is(name: ptr<AsmName>, key: u64, count: u64, fold: u64) -> bool {
    if (name.count != count) {
        return false;
    }
    var index: u64 = 0;
    while (index < count) {
        var value: u8 = name.bytes[index];
        if (fold != 0) {
            value = amd64_lower_byte(value);
        }
        if (value != ((key >> (index * 8)) & 255) as u8) {
            return false;
        }
        index += 1;
    }
    return true;
}

fun amd64_register(name: ptr<AsmName>, fold: u64, output: ptr<Amd64Register>) -> bool {
    if (name == null || output == null || fold > 1 || name.count > 8) {
        return false;
    }
    output.kind = 0;
    output.high8 = 0;
    output.rex8 = 0;
    // rax
    if (amd64_name_is(name, 7889266, 3, fold)) {
        output.code = 0;
        output.width = 64;
        return true;
    }
    // rcx
    if (amd64_name_is(name, 7889778, 3, fold)) {
        output.code = 1;
        output.width = 64;
        return true;
    }
    // rdx
    if (amd64_name_is(name, 7890034, 3, fold)) {
        output.code = 2;
        output.width = 64;
        return true;
    }
    // rbx
    if (amd64_name_is(name, 7889522, 3, fold)) {
        output.code = 3;
        output.width = 64;
        return true;
    }
    // rsp
    if (amd64_name_is(name, 7369586, 3, fold)) {
        output.code = 4;
        output.width = 64;
        return true;
    }
    // rbp
    if (amd64_name_is(name, 7365234, 3, fold)) {
        output.code = 5;
        output.width = 64;
        return true;

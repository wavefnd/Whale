// Callback-free, caller-owned encoder transport. Missing indexes use u64::MAX.
struct AmdSection {
    name: u64;
    kind: u64;
    align: u64;
    first: u64;
    size: u64;
    zero_fill: u64;
}

struct AmdSymbol {
    prefix: u64;
    name: u64;
    flags: u64;
    label_site: u64;
    extern_site: u64;
    global_site: u64;
    constant_site: u64;
    metadata_site: u64;
    section: u64;
    offset: u64;
    previous_section: u64;
    previous_offset: u64;
    low: u64;
    high: u64;
    dependency: u64;
    add_low: u64;
    add_high: u64;
    symbol_kind: u64;
    size: u64;
    visibility: u64;
    order: u64;
    users: u64;
    next: u64;
}

struct AmdNode {
    scope: u64;
    symbol: u64;
    section: u64;
    offset: u64;
    length: u64;
    previous_offset: u64;
    previous_length: u64;
    force_near: u64;
}

struct AmdRelocation {
    section: u64;
    offset: u64;
    symbol: u64;
    kind: u64;
    addend: u64;
    node: u64;
}

struct AmdEncodeInput {
    names: ptr<AsmName>;
    name_count: u64;
    items: ptr<AsmItem>;
    item_count: u64;
    operands: ptr<AsmOperand>;
    operand_count: u64;
    values: ptr<AsmDirectiveValue>;
    value_count: u64;
    sections: ptr<AmdSection>;
    section_capacity: u64;
    symbols: ptr<AmdSymbol>;
    symbol_capacity: u64;
    table: ptr<u64>;
    table_capacity: u64;
    nodes: ptr<AmdNode>;
    queue: ptr<u64>;
    relocations: ptr<AmdRelocation>;
    relocation_capacity: u64;
    bytes: ptr<u8>;
    byte_capacity: u64;
    max_output: u64;
    max_iterations: u64;
    max_work: u64;
}

struct AmdEncodeResult {
    status: u64;
    error: u64;
    node: u64;
    previous: u64;
    argument: u64;
    section_count: u64;
    symbol_count: u64;
    output_symbols: u64;
    relocation_count: u64;
    bytes: u64;
    iterations: u64;
    work: u64;
}

struct AmdWriter {
    p: ptr<AmdEncodeInput>;
    result: ptr<AmdEncodeResult>;
    section: u64;
    count: u64;
    materialized: u64;
    measuring: u64;
}

struct AmdOperand {
    kind: u64;
    code: u64;
    width: u64;
    flags: u64;
    low: u64;
    high: u64;
    mode: u64;
    memwidth: u64;
    base: u64;
    index: u64;
    scale: u64;
    disp: i64;
    symbol: u64;
}

struct AmdAddress {
    mode: u64;
    rm: u64;
    sib: u64;
    displacement: u64;
    width: u64;
    rex_b: u64;
    rex_x: u64;
}

fun amd_fail(result: ptr<AmdEncodeResult>, error: u64) -> bool {
    result.status = 1;
    result.error = error;
    return false;
}

fun amd_charge(p: ptr<AmdEncodeInput>, result: ptr<AmdEncodeResult>) -> bool {
    if (result.work >= p.max_work) {
        return amd_fail(result, 1);
    }
    result.work += 1;
    return true;
}

fun amd_word(names: ptr<AsmName>, count: u64, name: u64, word: u64, length: u64) -> bool {
    if (name >= count || names[name].count != length) {
        return false;
    }
    var at: u64 = 0;
    while (at < length) {
        if (names[name].bytes[at] != ((word >> (at * 8)) & 255) as u8) {
            return false;
        }
        at += 1;
    }
    return true;
}

fun amd_fits(low: u64, high: u64, width: u64, signed_only: bool) -> bool {
    if (width == 64) {
        if (high == 18446744073709551615) {
            return (low as i64) < 0;
        }
        return high == 0 && (!signed_only || low <= 9223372036854775807);
    }
    if (width != 8 && width != 16 && width != 32) {
        return false;
    }
    var sign: u64 = (1 as u64) << (width - 1);
    if (high == 18446744073709551615) {
        return (low as i64) >= -(sign as i64) && (low as i64) < 0;
    }
    var maximum: u64 = (sign << 1) - 1;
    if (signed_only) {
        maximum = sign - 1;
    }
    return high == 0 && low <= maximum;
}

fun amd_signed64(low: u64, high: u64) -> bool {
    return (high == 0 && low <= 9223372036854775807)
        || (high == 18446744073709551615 && low >= 9223372036854775808);
}

fun amd_register(p: ptr<AmdEncodeInput>, name: u64, output: ptr<AmdOperand>) -> bool {
    if (name >= p.name_count) {
        return false;
    }
    var register: Amd64Register;
    if (!amd64_register(&p.names[name], 0, &register)) {
        return false;
    }
    output.code = register.code;
    output.width = register.width;
    output.flags = register.high8 | (register.rex8 << 1) | (register.kind << 2);
    return true;
}


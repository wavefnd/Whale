// SPDX-License-Identifier: MPL-2.0
// The supported RV64I instruction inventory; no extension is inferred.
struct RvOpcode {
    form: u64;
    opcode: u64;
    f3: u64;
    f7: u64;
}

fun rv_lookup(text: FixedText, fold: u64, output: ptr<RvOpcode>) -> bool {
    // add
    if (asm_fixed_word(text, 6579297, 3, fold)) {
        output.form = 0;
        output.opcode = 51;
        output.f3 = 0;
        output.f7 = 0;
        return true;
    }
    // addw
    if (asm_fixed_word(text, 2003068001, 4, fold)) {
        output.form = 0;
        output.opcode = 59;
        output.f3 = 0;
        output.f7 = 0;
        return true;
    }
    // sub
    if (asm_fixed_word(text, 6452595, 3, fold)) {
        output.form = 0;
        output.opcode = 51;
        output.f3 = 0;
        output.f7 = 32;
        return true;
    }
    // subw
    if (asm_fixed_word(text, 2002941299, 4, fold)) {
        output.form = 0;
        output.opcode = 59;
        output.f3 = 0;
        output.f7 = 32;
        return true;
    }
    // sll
    if (asm_fixed_word(text, 7105651, 3, fold)) {
        output.form = 0;
        output.opcode = 51;
        output.f3 = 1;
        output.f7 = 0;
        return true;
    }
    // sllw
    if (asm_fixed_word(text, 2003594355, 4, fold)) {
        output.form = 0;
        output.opcode = 59;
        output.f3 = 1;
        output.f7 = 0;
        return true;
    }
    // slt
    if (asm_fixed_word(text, 7629939, 3, fold)) {
        output.form = 0;
        output.opcode = 51;
        output.f3 = 2;
        output.f7 = 0;
        return true;
    }
    // sltu
    if (asm_fixed_word(text, 1970564211, 4, fold)) {
        output.form = 0;
        output.opcode = 51;
        output.f3 = 3;
        output.f7 = 0;
        return true;
    }
    // xor
    if (asm_fixed_word(text, 7499640, 3, fold)) {
        output.form = 0;
        output.opcode = 51;
        output.f3 = 4;
        output.f7 = 0;
        return true;
    }
    // srl
    if (asm_fixed_word(text, 7107187, 3, fold)) {
        output.form = 0;
        output.opcode = 51;
        output.f3 = 5;
        output.f7 = 0;
        return true;
    }
    // srlw
    if (asm_fixed_word(text, 2003595891, 4, fold)) {
        output.form = 0;
        output.opcode = 59;
        output.f3 = 5;
        output.f7 = 0;
        return true;
    }
    // sra
    if (asm_fixed_word(text, 6386291, 3, fold)) {
        output.form = 0;
        output.opcode = 51;
        output.f3 = 5;
        output.f7 = 32;
        return true;
    }
    // sraw
    if (asm_fixed_word(text, 2002874995, 4, fold)) {
        output.form = 0;
        output.opcode = 59;
        output.f3 = 5;
        output.f7 = 32;
        return true;
    }
    // or
    if (asm_fixed_word(text, 29295, 2, fold)) {
        output.form = 0;
        output.opcode = 51;
        output.f3 = 6;
        output.f7 = 0;
        return true;
    }
    // and
    if (asm_fixed_word(text, 6581857, 3, fold)) {
        output.form = 0;
        output.opcode = 51;
        output.f3 = 7;
        output.f7 = 0;
        return true;
    }
    // addi
    if (asm_fixed_word(text, 1768186977, 4, fold)) {
        output.form = 1;
        output.opcode = 19;
        output.f3 = 0;
        output.f7 = 0;
        return true;
    }
    // slti
    if (asm_fixed_word(text, 1769237619, 4, fold)) {
        output.form = 1;
        output.opcode = 19;
        output.f3 = 2;
        output.f7 = 0;
        return true;
    }
    // sltiu
    if (asm_fixed_word(text, 504280411251, 5, fold)) {
        output.form = 1;
        output.opcode = 19;
        output.f3 = 3;
        output.f7 = 0;
        return true;
    }
    // xori
    if (asm_fixed_word(text, 1769107320, 4, fold)) {
        output.form = 1;
        output.opcode = 19;
        output.f3 = 4;
        output.f7 = 0;
        return true;
    }
    // ori
    if (asm_fixed_word(text, 6910575, 3, fold)) {
        output.form = 1;
        output.opcode = 19;
        output.f3 = 6;
        output.f7 = 0;
        return true;
    }
    // andi
    if (asm_fixed_word(text, 1768189537, 4, fold)) {
